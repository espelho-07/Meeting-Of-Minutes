@model Meeting_Of_Minutes.Models.UserModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Login | Meetings Of Minutes</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        body { min-height: 100vh; margin: 0; background: linear-gradient(135deg, #4538d6 0%, #4935d8 50%, #4338ca 100%); font-family: "Nunito", sans-serif; }
        .auth-shell { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 24px; }
        .auth-card { width: 100%; max-width: 474px; background: #fff; border-radius: 20px; box-shadow: 0 30px 60px rgba(21, 25, 71, 0.22); overflow: hidden; }
        .auth-card-top { background: linear-gradient(180deg, #f6f7ff 0%, #ffffff 100%); padding: 36px 36px 18px; text-align: center; }
        .auth-card-body { padding: 24px 36px 30px; }
        .auth-input-group { display: flex; align-items: center; border: 1px solid #d9e2f2; border-radius: 12px; background: #eef4ff; overflow: hidden; }
        .auth-input-group span { width: 48px; text-align: center; color: #95a2bb; }
        .auth-input-group input, .auth-input-group select { border: 0; background: transparent; box-shadow: none !important; min-height: 48px; }
        .auth-label { font-size: 0.86rem; font-weight: 700; color: #7c6cff; margin-bottom: 6px; }
        .signin { background: linear-gradient(90deg, #6674f4, #7a4db8); border: 0; border-radius: 10px; min-height: 46px; font-weight: 700; }
    </style>
</head>
<body>
    <div class="auth-shell">
        <div class="auth-card">
            <div class="auth-card-top">
                <div class="fw-bold fs-3" style="color:#5f62ee;">Meeting Of Minutes</div>
                <div class="fs-2 fw-bold mt-2">Welcome Back</div>
                <p class="text-muted mb-0">Sign in to continue</p>
            </div>
            <div class="auth-card-body">
                <form method="post" asp-controller="Auth" asp-action="Login">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger text-start mb-2"></div>

                    <label class="auth-label" asp-for="UserRole">Login As</label>
                    <div class="auth-input-group mb-3">
                        <span><i class="bi bi-shield-lock"></i></span>
                        <select asp-for="UserRole" class="form-select" id="loginRole">
                            <option value="">Select role</option>
                            <option value="Admin">Admin</option>
                            <option value="User">User</option>
                        </select>
                    </div>
                    <span asp-validation-for="UserRole" class="text-danger d-block text-start mb-2"></span>

                    <label class="auth-label" asp-for="DepartmentID" id="loginDepartmentLabel">Department</label>
                    <div class="auth-input-group mb-3" id="loginDepartmentWrap">
                        <span><i class="bi bi-building"></i></span>
                        <select asp-for="DepartmentID" asp-items="ViewBag.DepartmentDropDown" class="form-select">
                            <option value="">Select department</option>
                        </select>
                    </div>
                    <span asp-validation-for="DepartmentID" class="text-danger d-block text-start mb-2"></span>

                    <label class="auth-label" asp-for="Email">Email Address</label>
                    <div class="auth-input-group mb-3">
                        <span><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" type="email" class="form-control" placeholder="Enter email address">
                    </div>
                    <span asp-validation-for="Email" class="text-danger d-block text-start mb-2"></span>

                    <label class="auth-label" asp-for="Password">Password</label>
                    <div class="auth-input-group mb-3">
                        <span><i class="bi bi-key"></i></span>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Enter password" id="loginPassword">
                        <span style="width:44px;cursor:pointer;" onclick="toggleLoginPassword()"><i class="bi bi-eye"></i></span>
                    </div>
                    <span asp-validation-for="Password" class="text-danger d-block text-start mb-3"></span>

                    <button type="submit" class="signin btn w-100 py-2 text-white">Sign In</button>
                </form>
            </div>
        </div>
    </div>

    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleLoginPassword() {
            const input = document.getElementById('loginPassword');
            if (!input) return;
            input.type = input.type === 'password' ? 'text' : 'password';
        }

        function toggleLoginDepartment() {
            const role = document.getElementById('loginRole');
            const wrap = document.getElementById('loginDepartmentWrap');
            const label = document.getElementById('loginDepartmentLabel');
            if (!role || !wrap || !label) return;
            const show = role.value === 'User';
            wrap.style.display = show ? '' : 'none';
            label.style.display = show ? '' : 'none';
        }

        document.addEventListener('DOMContentLoaded', function () {
            const role = document.getElementById('loginRole');
            if (!role) return;
            role.addEventListener('change', toggleLoginDepartment);
            toggleLoginDepartment();
        });
    </script>
</body>
</html>
