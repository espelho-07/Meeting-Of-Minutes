@model List<MeetingVenueModel>

@await Html.PartialAsync("_AlertMessages")
@await Html.PartialAsync("_SaaSListStyles")
@{
    ViewData["Title"] = "Meeting Venues - Meeting Of Minutes";
    int SerialNumber = 1;
}

<div class="pagetitle mb-4">
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="DashBoard" asp-action="DashBoard"><i class="bi bi-house-door"></i></a></li>
            <li class="breadcrumb-item active">Meeting Venues</li>
        </ol>
    </nav>
</div>

<div class="list-page">
    <section class="list-hero">
        <div class="list-hero-main">
            <div class="list-kicker"><i class="bi bi-geo-alt"></i> Venue Directory</div>
            <h1 class="list-title">Meeting Venues</h1>
            <p class="list-subtitle">Keep physical rooms and virtual locations ready so meetings can be scheduled against approved venue records inside the company workspace.</p>
        </div>
        <aside class="list-note">
            <div class="list-note-label">Venue readiness</div>
            <h2 class="list-note-title">@Model.Count venues are currently available for scheduling.</h2>
            <ul class="list-note-list">
                <li><i class="bi bi-check2-circle"></i><span>Venues listed here appear directly in the Schedule Meeting form.</span></li>
                <li><i class="bi bi-check2-circle"></i><span>Keep names clean so meeting details stay readable and consistent.</span></li>
                <li><i class="bi bi-check2-circle"></i><span>Each company maintains only its own venue records.</span></li>
            </ul>
        </aside>
    </section>

    <section class="list-surface">
        <div class="list-surface-header">
            <div>
                <h3 class="list-surface-heading">Venue Records</h3>
                <p class="list-surface-meta">Search, review and manage venue definitions from one consistent scheduling surface.</p>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <a asp-action="MeetingVenueAddEdit" class="btn list-btn list-btn-primary"><i class="bi bi-plus-circle me-2"></i>Add Venue</a>
                <a asp-action="ExportToExcel" class="btn list-btn list-btn-success"><i class="bi bi-file-earmark-excel me-2"></i>Export</a>
            </div>
        </div>

        <div class="list-search-wrap">
            <div class="list-search-form">
                <div class="list-search-input">
                    <span><i class="bi bi-search"></i></span>
                    <input id="venueSearchInput" class="form-control" type="text" placeholder="Search venues..." onkeyup="filterVenueRows()" />
                </div>
                <button type="button" class="btn list-btn list-btn-primary" onclick="filterVenueRows()">Search</button>
                <button type="button" class="btn list-btn list-btn-light" onclick="resetVenueSearch()">Clear</button>
            </div>
            <div class="list-status-chip">Total Venues: @Model.Count</div>
        </div>

        <div class="list-table-wrap">
            <div class="list-table-card">
                @if (Model.Count == 0)
                {
                    <div class="list-empty">No venues found.</div>
                }
                else
                {
                    <table class="table align-middle" id="venueTable">
                        <thead>
                            <tr>
                                <th class="ps-4">#</th>
                                <th>Venue Name</th>
                                <th>Venue Code</th>
                                <th>Status</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var venue in Model)
                            {
                                <tr class="venue-row" data-venue-name="@venue.MeetingVenueName">
                                    <td class="ps-4">@SerialNumber</td>
                                    <td>
                                        <div class="fw-bold text-dark">@venue.MeetingVenueName</div>
                                        <div class="small text-muted">Approved meeting location</div>
                                    </td>
                                    <td><span class="badge bg-light text-dark border">MV-@venue.MeetingVenueID</span></td>
                                    <td><span class="badge bg-success-subtle text-success">Active</span></td>
                                    <td class="text-center">
                                        <a asp-action="MeetingVenueAddEdit" asp-route-id="@venue.MeetingVenueID" class="mom-icon-btn text-warning me-1" title="Edit"><i class="bi bi-pencil"></i></a>
                                        <form asp-action="Delete" method="post" class="d-inline js-delete-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="MeetingVenueID" value="@venue.MeetingVenueID" />
                                            <button type="submit" class="btn btn-link mom-icon-btn text-danger p-0" title="Delete"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </td>
                                </tr>
                                SerialNumber++;
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </section>
</div>

<script>
    function filterVenueRows() {
        var input = document.getElementById("venueSearchInput");
        var filter = (input.value || "").toUpperCase();
        var rows = document.querySelectorAll(".venue-row");

        rows.forEach(function (row) {
            var venueName = (row.getAttribute("data-venue-name") || "").toUpperCase();
            row.style.display = venueName.indexOf(filter) > -1 ? "" : "none";
        });
    }

    function resetVenueSearch() {
        var input = document.getElementById("venueSearchInput");
        input.value = "";
        filterVenueRows();
    }
</script>
