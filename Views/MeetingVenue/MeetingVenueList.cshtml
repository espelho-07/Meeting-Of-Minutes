@model PagedListViewModel<MeetingVenueModel>

@await Html.PartialAsync("_AlertMessages")
@await Html.PartialAsync("_SaaSListStyles")
@{
    ViewData["Title"] = "Meeting Venues - Meeting Of Minutes";
    int SerialNumber = 1;
    var heroModel = new ListPageHeroViewModel
    {
        IconClass = "bi bi-geo-alt",
        Kicker = "Venue Directory",
        Title = "Meeting Venues",
        Subtitle = "Keep physical rooms and virtual locations ready so meetings can be scheduled against approved venue records inside the company workspace.",
        NoteLabel = "Venue readiness",
        NoteTitle = $"{Model.TotalItems} venues are currently available for scheduling.",
        Notes = new List<string>
        {
            "Venues listed here appear directly in the Schedule Meeting form.",
            "Keep names clean so meeting details stay readable and consistent.",
            "Each company maintains only its own venue records."
        }
    };
    var toolbarModel = new ListPageToolbarViewModel
    {
        Heading = "Venue Records",
        Meta = "Search, review and manage venue definitions from one consistent scheduling surface.",
        SearchAction = "MeetingVenueList",
        SearchController = "MeetingVenue",
        SearchPlaceholder = "Search venues...",
        SearchText = ViewBag.searchtext,
        StatusText = $"Total Venues: {Model.TotalItems}",
        TemplateAction = "DownloadImportTemplate",
        TemplateController = "MeetingVenue",
        ImportAction = "ImportFromExcel",
        ImportController = "MeetingVenue",
        Actions = new List<ListToolbarActionViewModel>
        {
            new() { Action = "MeetingVenueAddEdit", Text = "Add Venue", IconClass = "bi bi-plus-circle", CssClass = "list-btn-primary" },
            new() { Action = "ExportToExcel", Text = "Export", IconClass = "bi bi-file-earmark-excel", CssClass = "list-btn-success" }
        }
    };
}

@await Html.PartialAsync("_ListBreadcrumb", new ListBreadcrumbViewModel { CurrentLabel = "Meeting Venues" })

<div class="list-page">
    @await Html.PartialAsync("_ListPageHero", heroModel)

    <section class="list-surface">
        @await Html.PartialAsync("_ListPageToolbar", toolbarModel)

        <div class="list-table-wrap">
            <div class="list-table-card">
                @if (Model.Items.Count == 0)
                {
                    @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel
                    {
                        IconClass = "bi bi-geo-alt",
                        Title = "No venues found",
                        Description = "There are no venue records matching the current filters or search term.",
                        ActionText = "Add Venue",
                        ActionUrl = Url.Action("MeetingVenueAddEdit", "MeetingVenue"),
                        Compact = true
                    })
                }
                else
                {
                    <table class="table align-middle" id="venueTable">
                        <thead>
                            <tr>
                                <th class="ps-4">#</th>
                                <th><a class="list-sort-link" href="@Url.Action("MeetingVenueList", new { searchtext = Model.SearchText, page = 1, sortBy = "name", sortDirection = Model.SortBy == "name" && Model.SortDirection == "asc" ? "desc" : "asc" })">Venue Name <i class="bi bi-arrow-down-up"></i></a></th>
                                <th><a class="list-sort-link" href="@Url.Action("MeetingVenueList", new { searchtext = Model.SearchText, page = 1, sortBy = "id", sortDirection = Model.SortBy == "id" && Model.SortDirection == "asc" ? "desc" : "asc" })">Venue Code <i class="bi bi-arrow-down-up"></i></a></th>
                                <th>Status</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var venue in Model.Items)
                            {
                                <tr>
                                    <td class="ps-4">@SerialNumber</td>
                                    <td>
                                        <div class="fw-bold text-dark">@venue.MeetingVenueName</div>
                                        <div class="small text-muted">Approved meeting location</div>
                                    </td>
                                    <td><span class="badge bg-light text-dark border">MV-@venue.MeetingVenueID</span></td>
                                    <td><span class="badge bg-success-subtle text-success">Active</span></td>
                                    <td class="text-center">
                                        <a asp-action="MeetingVenueAddEdit" asp-route-id="@venue.MeetingVenueID" class="mom-icon-btn text-warning me-1" title="Edit"><i class="bi bi-pencil"></i></a>
                                        <form asp-action="Delete" method="post" class="d-inline js-delete-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="MeetingVenueID" value="@venue.MeetingVenueID" />
                                            <button type="submit" class="btn btn-link mom-icon-btn text-danger p-0" title="Delete"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </td>
                                </tr>
                                SerialNumber++;
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
        @await Html.PartialAsync("_ListPagination", Model)
    </section>
</div>
