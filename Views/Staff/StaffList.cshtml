@model PagedListViewModel<StaffModel>

@await Html.PartialAsync("_AlertMessages")
@await Html.PartialAsync("_SaaSListStyles")
@{
    ViewData["Title"] = "Staff Members - Meeting Of Minutes";
    int SerialNumber = 1;
    var heroModel = new ListPageHeroViewModel
    {
        IconClass = "bi bi-people",
        Kicker = "Staff Access",
        Title = "Staff Members",
        Subtitle = "Manage staff records, auto-created user access and company participation from the same clean workspace language used in meeting scheduling.",
        NoteLabel = "Access notes",
        NoteTitle = $"{Model.TotalItems} staff records are active in the current company scope.",
        Notes = new List<string>
        {
            "Every staff record can create or sync a linked user account automatically.",
            "Department placement controls meeting visibility and transfer workflows.",
            "Open staff details to review password state, transfer history and enrolled meetings."
        }
    };
    var toolbarModel = new ListPageToolbarViewModel
    {
        Heading = "Staff Directory",
        Meta = "Search, review and manage staff records from one consistent administrative surface.",
        SearchAction = "StaffList",
        SearchController = "Staff",
        SearchPlaceholder = "Search staff members...",
        SearchText = ViewBag.searchtext,
        StatusText = $"Total Records: {Model.TotalItems}",
        TemplateAction = "DownloadImportTemplate",
        TemplateController = "Staff",
        ImportAction = "ImportFromExcel",
        ImportController = "Staff",
        Actions = new List<ListToolbarActionViewModel>
        {
            new() { Action = "StaffAddEdit", Text = "Add Staff Member", IconClass = "bi bi-person-plus-fill", CssClass = "list-btn-primary" },
            new() { Action = "ExportToExcel", Text = "Export", IconClass = "bi bi-file-earmark-excel", CssClass = "list-btn-success" }
        }
    };
}

@await Html.PartialAsync("_ListBreadcrumb", new ListBreadcrumbViewModel { CurrentLabel = "Staff Members" })

<div class="list-page">
    @await Html.PartialAsync("_ListPageHero", heroModel)

    <section class="list-surface">
        @await Html.PartialAsync("_ListPageToolbar", toolbarModel)

        <div class="list-table-wrap">
            <div class="list-table-card">
                @if (Model.Items.Count == 0)
                {
                    @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel
                    {
                        IconClass = "bi bi-people",
                        Title = "No staff members found",
                        Description = "There are no staff records matching the current query or company scope.",
                        ActionText = "Add Staff Member",
                        ActionUrl = Url.Action("StaffAddEdit", "Staff"),
                        Compact = true
                    })
                }
                else
                {
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th class="ps-4">#</th>
                                <th><a class="list-sort-link" href="@Url.Action("StaffList", new { searchtext = Model.SearchText, page = 1, sortBy = "name", sortDirection = Model.SortBy == "name" && Model.SortDirection == "asc" ? "desc" : "asc" })">Staff Member <i class="bi bi-arrow-down-up"></i></a></th>
                                <th><a class="list-sort-link" href="@Url.Action("StaffList", new { searchtext = Model.SearchText, page = 1, sortBy = "department", sortDirection = Model.SortBy == "department" && Model.SortDirection == "asc" ? "desc" : "asc" })">Department <i class="bi bi-arrow-down-up"></i></a></th>
                                <th><a class="list-sort-link" href="@Url.Action("StaffList", new { searchtext = Model.SearchText, page = 1, sortBy = "email", sortDirection = Model.SortBy == "email" && Model.SortDirection == "asc" ? "desc" : "asc" })">Mobile & Email <i class="bi bi-arrow-down-up"></i></a></th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var staff in Model.Items)
                            {
                                <tr>
                                    <td class="ps-4">@SerialNumber</td>
                                    <td>
                                        <div class="fw-bold text-dark">@staff.StaffName</div>
                                        <div class="small text-muted">Auto user account enabled</div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark">@staff.DepartmentName</div>
                                        <div class="small text-muted">@(string.IsNullOrWhiteSpace(staff.CompanyName) ? "-" : staff.CompanyName)</div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark">@staff.MobileNo</div>
                                        <div class="small text-muted">@staff.EmailAddress</div>
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="StaffView" asp-route-id="@staff.StaffID" class="mom-icon-btn text-primary me-1" title="View">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="StaffAddEdit" asp-route-id="@staff.StaffID" class="mom-icon-btn text-warning me-1" title="Edit">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <form asp-action="Delete" method="post" class="d-inline js-delete-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="StaffID" value="@staff.StaffID" />
                                            <button type="submit" class="btn btn-sm btn-link mom-icon-btn text-danger p-0">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                                SerialNumber++;
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
        @await Html.PartialAsync("_ListPagination", Model)
    </section>
</div>
