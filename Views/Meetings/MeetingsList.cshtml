@model List<MeetingsModel>

@await Html.PartialAsync("_AlertMessages")
@await Html.PartialAsync("_SaaSListStyles")
@{
    ViewData["Title"] = "Meetings Management - MOM";
    int SerialNumber = 1;
    bool isAdminUser = (Context.Session.GetString("UserRole") ?? string.Empty).Equals("Admin", StringComparison.OrdinalIgnoreCase);
}

<div class="pagetitle mb-4">
    <nav>
        <ol class="breadcrumb flex-nowrap">
            <li class="breadcrumb-item"><a asp-controller="DashBoard" asp-action="DashBoard"><i class="bi bi-house-door"></i></a></li>
            <li class="breadcrumb-item active">Meetings</li>
        </ol>
    </nav>
</div>

<div class="list-page">
    <section class="list-hero">
        <div class="list-hero-main">
            <div class="list-kicker"><i class="bi bi-calendar2-week"></i> Meeting Operations</div>
            <h1 class="list-title">All Meetings</h1>
            <p class="list-subtitle">Review scheduled, completed and cancelled meetings from the same workspace language used while creating them.</p>
        </div>
        <aside class="list-note">
            <div class="list-note-label">Operational scope</div>
            <h2 class="list-note-title">@Model.Count meeting records are visible in your current access scope.</h2>
            <ul class="list-note-list">
                <li><i class="bi bi-check2-circle"></i><span>Admins can schedule and cancel meetings from this list.</span></li>
                <li><i class="bi bi-check2-circle"></i><span>Users only see meetings actually assigned to their meeting membership.</span></li>
                <li><i class="bi bi-check2-circle"></i><span>Open the details workspace to manage attendees and attendance.</span></li>
            </ul>
        </aside>
    </section>

    <section class="list-surface">
        <div class="list-surface-header">
            <div>
                <h3 class="list-surface-heading">Meeting Register</h3>
                <p class="list-surface-meta">Search, open and manage meeting records from one consistent scheduling surface.</p>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                @if (isAdminUser)
                {
                    <a asp-action="MeetingsAddEdit" class="btn list-btn list-btn-primary"><i class="bi bi-plus-circle me-2"></i>Schedule Meeting</a>
                    <a asp-action="ExportToExcel" class="btn list-btn list-btn-success"><i class="bi bi-file-earmark-excel me-2"></i>Export</a>
                }
            </div>
        </div>

        <div class="list-search-wrap">
            <form class="list-search-form" asp-action="MeetingsList" asp-controller="Meetings" method="post">
                @Html.AntiForgeryToken()
                <div class="list-search-input">
                    <span><i class="bi bi-search"></i></span>
                    <input class="form-control" name="searchtext" value="@ViewBag.searchtext" type="text" placeholder="Search meetings..." />
                </div>
                <button class="btn list-btn list-btn-primary" type="submit">Search</button>
                <a href="@Url.Action("MeetingsList", "Meetings")" class="btn list-btn list-btn-light">Clear</a>
            </form>
            <div class="list-status-chip">Total Records: @Model.Count</div>
        </div>

        <div class="list-table-wrap">
            <div class="list-table-card">
                @if (Model.Count == 0)
                {
                    <div class="list-empty">No meetings found.</div>
                }
                else
                {
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th class="ps-4">#</th>
                                <th>Date & Time</th>
                                <th>Meeting Type</th>
                                <th>Description</th>
                                <th>Department</th>
                                <th>Venue</th>
                                <th>Status</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var meeting in Model)
                            {
                                <tr>
                                    <td class="ps-4">@SerialNumber</td>
                                    <td>
                                        <div class="fw-bold text-dark">@meeting.MeetingDate?.ToString("dd MMM yyyy")</div>
                                        <div class="small text-muted">@meeting.MeetingDate?.ToString("hh:mm tt")</div>
                                    </td>
                                    <td>@meeting.MeetingTypeName</td>
                                    <td>
                                        <div class="fw-semibold text-dark">@meeting.MeetingDescription</div>
                                        <div class="small text-muted">Operational meeting record</div>
                                    </td>
                                    <td>@meeting.DepartmentName</td>
                                    <td>@meeting.MeetingVenueName</td>
                                    <td>
                                        @if (meeting.IsCancelled)
                                        {
                                            <span class="badge bg-danger">Cancelled</span>
                                        }
                                        else if (meeting.MeetingDate > DateTime.Now)
                                        {
                                            <span class="badge bg-primary">Scheduled</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Completed</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="MeetingsDetails" asp-route-id="@meeting.MeetingID" class="mom-icon-btn text-primary me-1" title="View Meeting"><i class="bi bi-card-list"></i></a>
                                        @if (isAdminUser)
                                        {
                                            <form asp-action="Delete" method="post" class="d-inline js-delete-form">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="MeetingID" value="@meeting.MeetingID" />
                                                <button type="submit" class="btn btn-sm btn-link mom-icon-btn text-danger p-0"><i class="bi bi-trash"></i></button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                                SerialNumber++;
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </section>
</div>
