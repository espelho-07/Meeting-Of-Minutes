@model PagedListViewModel<MeetingsModel>

@await Html.PartialAsync("_AlertMessages")
@await Html.PartialAsync("_SaaSListStyles")
@{
    ViewData["Title"] = "Meetings Management - MOM";
    int SerialNumber = 1;
    bool isAdminUser = (Context.Session.GetString("UserRole") ?? string.Empty).Equals("Admin", StringComparison.OrdinalIgnoreCase);
    var heroModel = new ListPageHeroViewModel
    {
        IconClass = "bi bi-calendar2-week",
        Kicker = "Meeting Operations",
        Title = "All Meetings",
        Subtitle = "Review scheduled, completed and cancelled meetings from the same workspace language used while creating them.",
        NoteLabel = "Operational scope",
        NoteTitle = $"{Model.TotalItems} meeting records are visible in your current access scope.",
        Notes = new List<string>
        {
            "Admins can schedule and cancel meetings from this list.",
            "Users only see meetings actually assigned to their meeting membership.",
            "Open the details workspace to manage attendees and attendance."
        }
    };
    var toolbarModel = new ListPageToolbarViewModel
    {
        Heading = "Meeting Register",
        Meta = "Search, open and manage meeting records from one consistent scheduling surface.",
        SearchAction = "MeetingsList",
        SearchController = "Meetings",
        SearchPlaceholder = "Search meetings...",
        SearchText = ViewBag.searchtext,
        StatusText = $"Total Records: {Model.TotalItems}",
        TemplateAction = isAdminUser ? "DownloadImportTemplate" : null,
        TemplateController = isAdminUser ? "Meetings" : null,
        ImportAction = isAdminUser ? "ImportFromExcel" : null,
        ImportController = isAdminUser ? "Meetings" : null,
        Actions = isAdminUser
            ? new List<ListToolbarActionViewModel>
            {
                new() { Action = "MeetingsAddEdit", Text = "Schedule Meeting", IconClass = "bi bi-plus-circle", CssClass = "list-btn-primary" },
                new() { Action = "ExportToExcel", Text = "Export", IconClass = "bi bi-file-earmark-excel", CssClass = "list-btn-success" }
            }
            : new List<ListToolbarActionViewModel>()
    };
}

@await Html.PartialAsync("_ListBreadcrumb", new ListBreadcrumbViewModel { CurrentLabel = "Meetings" })

<div class="list-page">
    @await Html.PartialAsync("_ListPageHero", heroModel)

    <section class="list-surface">
        @await Html.PartialAsync("_ListPageToolbar", toolbarModel)

        <div class="list-table-wrap">
            <div class="list-table-card">
                @if (Model.Items.Count == 0)
                {
                    @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel
                    {
                        IconClass = "bi bi-calendar2-week",
                        Title = "No meetings found",
                        Description = "There are no meeting records visible for the current search or access scope.",
                        ActionText = isAdminUser ? "Schedule Meeting" : null,
                        ActionUrl = isAdminUser ? Url.Action("MeetingsAddEdit", "Meetings") : null,
                        Compact = true
                    })
                }
                else
                {
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th class="ps-4">#</th>
                                <th><a class="list-sort-link" href="@Url.Action("MeetingsList", new { searchtext = Model.SearchText, page = 1, sortBy = "date", sortDirection = Model.SortBy == "date" && Model.SortDirection == "asc" ? "desc" : "asc" })">Date & Time <i class="bi bi-arrow-down-up"></i></a></th>
                                <th><a class="list-sort-link" href="@Url.Action("MeetingsList", new { searchtext = Model.SearchText, page = 1, sortBy = "type", sortDirection = Model.SortBy == "type" && Model.SortDirection == "asc" ? "desc" : "asc" })">Meeting Type <i class="bi bi-arrow-down-up"></i></a></th>
                                <th>Description</th>
                                <th><a class="list-sort-link" href="@Url.Action("MeetingsList", new { searchtext = Model.SearchText, page = 1, sortBy = "department", sortDirection = Model.SortBy == "department" && Model.SortDirection == "asc" ? "desc" : "asc" })">Department <i class="bi bi-arrow-down-up"></i></a></th>
                                <th>Venue</th>
                                <th><a class="list-sort-link" href="@Url.Action("MeetingsList", new { searchtext = Model.SearchText, page = 1, sortBy = "status", sortDirection = Model.SortBy == "status" && Model.SortDirection == "asc" ? "desc" : "asc" })">Status <i class="bi bi-arrow-down-up"></i></a></th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var meeting in Model.Items)
                            {
                                <tr>
                                    <td class="ps-4">@SerialNumber</td>
                                    <td>
                                        <div class="fw-bold text-dark">@meeting.MeetingDate?.ToString("dd MMM yyyy")</div>
                                        <div class="small text-muted">@meeting.MeetingDate?.ToString("hh:mm tt")</div>
                                    </td>
                                    <td>@meeting.MeetingTypeName</td>
                                    <td>
                                        <div class="fw-semibold text-dark">@meeting.MeetingDescription</div>
                                        <div class="small text-muted">Operational meeting record</div>
                                    </td>
                                    <td>@meeting.DepartmentName</td>
                                    <td>@meeting.MeetingVenueName</td>
                                    <td>
                                        @if (meeting.IsCancelled)
                                        {
                                            <span class="badge bg-danger">Cancelled</span>
                                        }
                                        else if (meeting.MeetingDate > DateTime.Now)
                                        {
                                            <span class="badge bg-primary">Scheduled</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Completed</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="MeetingsDetails" asp-route-id="@meeting.MeetingID" class="mom-icon-btn text-primary me-1" title="View Meeting"><i class="bi bi-card-list"></i></a>
                                        @if (isAdminUser)
                                        {
                                            <form asp-action="Delete" method="post" class="d-inline js-delete-form">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="MeetingID" value="@meeting.MeetingID" />
                                                <button type="submit" class="btn btn-sm btn-link mom-icon-btn text-danger p-0"><i class="bi bi-trash"></i></button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                                SerialNumber++;
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
        @await Html.PartialAsync("_ListPagination", Model)
    </section>
</div>
