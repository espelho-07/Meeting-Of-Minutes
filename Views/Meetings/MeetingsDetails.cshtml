@model Meeting_Of_Minutes.Models.MeetingDetailsViewModel
@using Meeting_Of_Minutes.Services
@{
    string safeMeetingDocumentPath = FileSecurityService.SanitizeStoredDocumentPath(Model.Meeting.DocumentPath);
}
@await Html.PartialAsync("_AlertMessages")
@await Html.PartialAsync("_SaaSViewStyles")
@{
    ViewData["Title"] = "Meeting Details - Meeting Of Minutes";
    bool isAdminUser = (Context.Session.GetString("UserRole") ?? string.Empty).Equals("Admin", StringComparison.OrdinalIgnoreCase);
}

<div class="pagetitle mb-4">
    <nav>
        <ol class="breadcrumb flex-nowrap">
            <li class="breadcrumb-item"><a asp-controller="DashBoard" asp-action="DashBoard"><i class="bi bi-house-door"></i></a></li>
            <li class="breadcrumb-item"><a asp-controller="Meetings" asp-action="MeetingsList">Meetings</a></li>
            <li class="breadcrumb-item active">Meeting Details</li>
        </ol>
    </nav>
</div>

<div class="view-page">
    <section class="view-hero">
        <div class="view-hero-main">
            <div class="view-kicker"><i class="bi bi-calendar-event"></i> Meeting Workspace</div>
            <h1 class="view-title">@(string.IsNullOrWhiteSpace(Model.Meeting.MeetingDescription) ? "Meeting Record" : Model.Meeting.MeetingDescription)</h1>
            <p class="view-subtitle">@(isAdminUser ? "View meeting information, participants and attendance updates from one focused workspace." : "View your assigned meeting details and attendance state.")</p>
        </div>
        <aside class="view-note">
            <div class="view-note-label">Participants</div>
            <h2 class="view-note-title">@Model.Members.Count member(s) currently included in this meeting.</h2>
            <ul class="view-note-list">
                <li><i class="bi bi-check2-circle"></i><span>Members shown below were added from the selected department scope.</span></li>
                <li><i class="bi bi-check2-circle"></i><span>Excluded users lose access to this meeting immediately.</span></li>
            </ul>
        </aside>
    </section>

    <section class="view-card mb-4">
        <div class="view-card-header">
            <div>
                <h3 class="view-card-heading">Meeting Information</h3>
                <p class="view-card-meta">Core schedule, scope and document details for this meeting.</p>
            </div>
            <div class="view-actions">
                @if (isAdminUser)
                {
                    <a asp-action="MeetingsAddEdit" asp-route-id="@Model.Meeting.MeetingID" class="btn view-btn view-btn-primary">Edit Meeting</a>
                }
                <a asp-action="MeetingsList" class="btn view-btn view-btn-light">Back to List</a>
            </div>
        </div>
        <div class="view-card-body">
            <div class="view-detail-grid">
                <div class="view-detail-item">
                    <span class="view-detail-label">Meeting Date & Time</span>
                    <div class="view-detail-value">@Model.Meeting.MeetingDate</div>
                </div>
                <div class="view-detail-item">
                    <span class="view-detail-label">Status</span>
                    <div class="view-detail-value">
                        @if (Model.Meeting.IsCancelled)
                        {
                            <span class="view-badge">Cancelled</span>
                        }
                        else if (Model.Meeting.MeetingDate > DateTime.Now)
                        {
                            <span class="view-badge">Scheduled</span>
                        }
                        else
                        {
                            <span class="view-badge">Completed</span>
                        }
                    </div>
                </div>
                <div class="view-detail-item">
                    <span class="view-detail-label">Meeting Type</span>
                    <div class="view-detail-value">@(string.IsNullOrWhiteSpace(Model.Meeting.MeetingTypeName) ? "-" : Model.Meeting.MeetingTypeName)</div>
                </div>
                <div class="view-detail-item">
                    <span class="view-detail-label">Department</span>
                    <div class="view-detail-value">@(string.IsNullOrWhiteSpace(Model.Meeting.DepartmentName) ? "-" : Model.Meeting.DepartmentName)</div>
                </div>
                <div class="view-detail-item">
                    <span class="view-detail-label">Venue</span>
                    <div class="view-detail-value">@(string.IsNullOrWhiteSpace(Model.Meeting.MeetingVenueName) ? "-" : Model.Meeting.MeetingVenueName)</div>
                </div>
                <div class="view-detail-item">
                    <span class="view-detail-label">Document</span>
                    <div class="view-detail-value">
                    @if (!string.IsNullOrWhiteSpace(safeMeetingDocumentPath))
                    {
                        <a href="@safeMeetingDocumentPath" target="_blank" rel="noopener noreferrer">View Uploaded File</a>
                    }
                        else
                        {
                            <span class="view-detail-value muted">-</span>
                        }
                    </div>
                </div>
                <div class="view-detail-item wide">
                    <span class="view-detail-label">Description</span>
                    <div class="view-detail-value muted">@(string.IsNullOrWhiteSpace(Model.Meeting.MeetingDescription) ? "-" : Model.Meeting.MeetingDescription)</div>
                </div>
                @if (Model.Meeting.IsCancelled)
                {
                    <div class="view-detail-item">
                        <span class="view-detail-label">Cancellation Date & Time</span>
                        <div class="view-detail-value">@Model.Meeting.CancellationDateTime</div>
                    </div>
                    <div class="view-detail-item">
                        <span class="view-detail-label">Cancellation Reason</span>
                        <div class="view-detail-value muted">@(string.IsNullOrWhiteSpace(Model.Meeting.CancellationReason) ? "-" : Model.Meeting.CancellationReason)</div>
                    </div>
                }
            </div>
        </div>
    </section>

    <section class="view-card">
        <div class="view-card-header">
            <div>
                <h3 class="view-card-heading">Who Is Going To Attend The Meeting</h3>
                <p class="view-card-meta">Current member records and attendance updates for this meeting.</p>
            </div>
        </div>
        <div class="view-card-body">
            @if (Model.Members.Count == 0)
            {
                <div class="view-detail-item">
                    <span class="view-detail-value muted">No members added yet.</span>
                </div>
            }
            else
            {
                <div class="view-list">
                    @foreach (var member in Model.Members)
                    {
                        <div class="view-list-row">
                            <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                                <div>
                                    <div class="view-list-title">@member.StaffName</div>
                                    <div class="view-list-meta">Attendance record</div>
                                </div>
                                <span class="view-badge">@(member.IsPresent ? "Present" : "Absent")</span>
                            </div>

                            @if (isAdminUser)
                            {
                                <form asp-action="UpdateMeetingMemberAttendance" method="post" class="row g-3 mb-3">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="MeetingMemberID" value="@member.MeetingMemberID" />
                                    <input type="hidden" name="MeetingID" value="@Model.Meeting.MeetingID" />
                                    <div class="col-md-5">
                                        <label class="form-label small fw-bold">At Meeting Time</label>
                                        <select name="IsPresent" class="form-select">
                                            @if (member.IsPresent)
                                            {
                                                <option value="true" selected>Present</option>
                                                <option value="false">Absent</option>
                                            }
                                            else
                                            {
                                                <option value="true">Present</option>
                                                <option value="false" selected>Absent</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-7">
                                        <label class="form-label small fw-bold">Remarks</label>
                                        <input type="text" name="Remarks" value="@member.Remarks" class="form-control" />
                                    </div>
                                    <div class="col-12 d-flex justify-content-end gap-2">
                                        <button type="submit" class="btn view-btn view-btn-primary">Update</button>
                                    </div>
                                </form>
                                <div class="d-flex justify-content-end">
                                    <form asp-action="DeleteMeetingMember" method="post" class="js-delete-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="MeetingMemberID" value="@member.MeetingMemberID" />
                                        <input type="hidden" name="MeetingID" value="@Model.Meeting.MeetingID" />
                                        <button type="submit" class="btn view-btn view-btn-danger">Exclude</button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <div class="view-detail-item">
                                    <span class="view-detail-label">Remarks</span>
                                    <div class="view-detail-value muted">@(string.IsNullOrWhiteSpace(member.Remarks) ? "-" : member.Remarks)</div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </section>
</div>
