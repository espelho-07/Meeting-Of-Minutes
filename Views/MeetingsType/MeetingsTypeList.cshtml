@model PagedListViewModel<MeetingTypeModel>

@await Html.PartialAsync("_AlertMessages")
@await Html.PartialAsync("_SaaSListStyles")
@{
    ViewData["Title"] = "Meeting Types - Meeting Of Minutes";
    int SerialNumber = 1;
    var heroModel = new ListPageHeroViewModel
    {
        IconClass = "bi bi-tags",
        Kicker = "Meeting Taxonomy",
        Title = "Meeting Types",
        Subtitle = "Define the meeting labels that drive reporting, scheduling and cleaner categorization across your company workspace.",
        NoteLabel = "Usage guidance",
        NoteTitle = $"{Model.TotalItems} configured meeting types in the current company scope.",
        Notes = new List<string>
        {
            "Keep names short and recognizable so meeting records stay easy to scan.",
            "Remarks help admins understand where each meeting category should be used.",
            "Only company-scoped types appear while scheduling new meetings."
        }
    };
    var toolbarModel = new ListPageToolbarViewModel
    {
        Heading = "Meeting Type Directory",
        Meta = "Search, review and maintain type definitions from one clean operational surface.",
        SearchAction = "MeetingsTypeList",
        SearchController = "MeetingsType",
        SearchPlaceholder = "Search meeting type name...",
        SearchText = ViewBag.searchtext,
        StatusText = $"Total Records: {Model.TotalItems}",
        TemplateAction = "DownloadImportTemplate",
        TemplateController = "MeetingsType",
        ImportAction = "ImportFromExcel",
        ImportController = "MeetingsType",
        Actions = new List<ListToolbarActionViewModel>
        {
            new() { Action = "MeetingsTypeAddEdit", Text = "Add New Type", IconClass = "bi bi-plus-circle", CssClass = "list-btn-primary" },
            new() { Action = "ExportToExcel", Text = "Export", IconClass = "bi bi-file-earmark-excel", CssClass = "list-btn-success" }
        }
    };
}

@await Html.PartialAsync("_ListBreadcrumb", new ListBreadcrumbViewModel { CurrentLabel = "Meeting Types" })

<div class="list-page">
    @await Html.PartialAsync("_ListPageHero", heroModel)

    <section class="list-surface">
        @await Html.PartialAsync("_ListPageToolbar", toolbarModel)

        <div class="list-table-wrap">
            <div class="list-table-card">
                @if (Model.Items.Count == 0)
                {
                    @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel
                    {
                        IconClass = "bi bi-tags",
                        Title = "No meeting types found",
                        Description = "There are no meeting type definitions matching the current result set.",
                        ActionText = "Add New Type",
                        ActionUrl = Url.Action("MeetingsTypeAddEdit", "MeetingsType"),
                        Compact = true
                    })
                }
                else
                {
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th class="ps-4">#</th>
                                <th><a class="list-sort-link" href="@Url.Action("MeetingsTypeList", new { searchtext = Model.SearchText, page = 1, sortBy = "name", sortDirection = Model.SortBy == "name" && Model.SortDirection == "asc" ? "desc" : "asc" })">Meeting Type Name <i class="bi bi-arrow-down-up"></i></a></th>
                                <th>Remarks</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var meetingType in Model.Items)
                            {
                                <tr>
                                    <td class="ps-4">@SerialNumber</td>
                                    <td>
                                        <div class="fw-bold text-dark">@meetingType.MeetingTypeName</div>
                                        <div class="small text-muted">Meeting category</div>
                                    </td>
                                    <td class="text-muted">@(string.IsNullOrWhiteSpace(meetingType.Remarks) ? "-" : meetingType.Remarks)</td>
                                    <td class="text-center">
                                        <a asp-action="MeetingsTypeDetails" asp-route-id="@meetingType.MeetingTypeID" class="mom-icon-btn text-primary me-1"><i class="bi bi-eye"></i></a>
                                        <a asp-action="MeetingsTypeAddEdit" asp-route-id="@meetingType.MeetingTypeID" class="mom-icon-btn text-warning me-1"><i class="bi bi-pencil"></i></a>
                                        <form asp-action="Delete" method="post" class="d-inline js-delete-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="MeetingTypeID" value="@meetingType.MeetingTypeID" />
                                            <button type="submit" class="btn btn-link mom-icon-btn text-danger p-0"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </td>
                                </tr>
                                SerialNumber++;
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
        @await Html.PartialAsync("_ListPagination", Model)
    </section>
</div>
