@model List<MeetingTypeModel>

@await Html.PartialAsync("_AlertMessages")
@await Html.PartialAsync("_SaaSListStyles")
@{
    ViewData["Title"] = "Meeting Types - Meeting Of Minutes";
    int SerialNumber = 1;
}

<div class="pagetitle mb-4">
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="DashBoard" asp-action="DashBoard"><i class="bi bi-house-door"></i></a></li>
            <li class="breadcrumb-item active">Meeting Types</li>
        </ol>
    </nav>
</div>

<div class="list-page">
    <section class="list-hero">
        <div class="list-hero-main">
            <div class="list-kicker"><i class="bi bi-tags"></i> Meeting Taxonomy</div>
            <h1 class="list-title">Meeting Types</h1>
            <p class="list-subtitle">Define the meeting labels that drive reporting, scheduling and cleaner categorization across your company workspace.</p>
        </div>
        <aside class="list-note">
            <div class="list-note-label">Usage guidance</div>
            <h2 class="list-note-title">@Model.Count configured meeting types in the current company scope.</h2>
            <ul class="list-note-list">
                <li><i class="bi bi-check2-circle"></i><span>Keep names short and recognizable so meeting records stay easy to scan.</span></li>
                <li><i class="bi bi-check2-circle"></i><span>Remarks help admins understand where each meeting category should be used.</span></li>
                <li><i class="bi bi-check2-circle"></i><span>Only company-scoped types appear while scheduling new meetings.</span></li>
            </ul>
        </aside>
    </section>

    <section class="list-surface">
        <div class="list-surface-header">
            <div>
                <h3 class="list-surface-heading">Meeting Type Directory</h3>
                <p class="list-surface-meta">Search, review and maintain type definitions from one clean operational surface.</p>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <a asp-action="MeetingsTypeAddEdit" class="btn list-btn list-btn-primary"><i class="bi bi-plus-circle me-2"></i>Add New Type</a>
                <a asp-action="ExportToExcel" class="btn list-btn list-btn-success"><i class="bi bi-file-earmark-excel me-2"></i>Export</a>
            </div>
        </div>

        <div class="list-search-wrap">
            <form class="list-search-form" asp-action="MeetingsTypeList" asp-controller="MeetingsType" method="post">
                @Html.AntiForgeryToken()
                <div class="list-search-input">
                    <span><i class="bi bi-search"></i></span>
                    <input class="form-control" name="searchtext" value="@ViewBag.searchtext" type="text" placeholder="Search meeting type name..." />
                </div>
                <button class="btn list-btn list-btn-primary" type="submit">Search</button>
                <a href="@Url.Action("MeetingsTypeList", "MeetingsType")" class="btn list-btn list-btn-light">Clear</a>
            </form>
            <div class="list-status-chip">Total Records: @Model.Count</div>
        </div>

        <div class="list-table-wrap">
            <div class="list-table-card">
                @if (Model.Count == 0)
                {
                    <div class="list-empty">No meeting types found.</div>
                }
                else
                {
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th class="ps-4">#</th>
                                <th>Meeting Type Name</th>
                                <th>Remarks</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var meetingType in Model)
                            {
                                <tr>
                                    <td class="ps-4">@SerialNumber</td>
                                    <td>
                                        <div class="fw-bold text-dark">@meetingType.MeetingTypeName</div>
                                        <div class="small text-muted">Meeting category</div>
                                    </td>
                                    <td class="text-muted">@(string.IsNullOrWhiteSpace(meetingType.Remarks) ? "-" : meetingType.Remarks)</td>
                                    <td class="text-center">
                                        <a asp-action="MeetingsTypeDetails" asp-route-id="@meetingType.MeetingTypeID" class="mom-icon-btn text-primary me-1"><i class="bi bi-eye"></i></a>
                                        <a asp-action="MeetingsTypeAddEdit" asp-route-id="@meetingType.MeetingTypeID" class="mom-icon-btn text-warning me-1"><i class="bi bi-pencil"></i></a>
                                        <form asp-action="Delete" method="post" class="d-inline js-delete-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="MeetingTypeID" value="@meetingType.MeetingTypeID" />
                                            <button type="submit" class="btn btn-link mom-icon-btn text-danger p-0"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </td>
                                </tr>
                                SerialNumber++;
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </section>
</div>
