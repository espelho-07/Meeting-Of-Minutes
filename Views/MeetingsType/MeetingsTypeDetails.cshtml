@model MeetingTypeModel
@await Html.PartialAsync("_AlertMessages")
@await Html.PartialAsync("_SaaSViewStyles")
@{
    ViewData["Title"] = "Meeting Type Details - MOM";
}

<div class="pagetitle mb-4">
    <nav>
        <ol class="breadcrumb flex-nowrap">
            <li class="breadcrumb-item"><a asp-controller="DashBoard" asp-action="DashBoard"><i class="bi bi-house-door"></i></a></li>
            <li class="breadcrumb-item"><a asp-controller="MeetingsType" asp-action="MeetingsTypeList">Meeting Types</a></li>
            <li class="breadcrumb-item active">Details</li>
        </ol>
    </nav>
</div>

<div class="view-page">
    <section class="view-hero">
        <div class="view-hero-main">
            <div class="view-kicker"><i class="bi bi-tags"></i> Meeting Type View</div>
            <h1 class="view-title">@Model.MeetingTypeName</h1>
            <p class="view-subtitle">Review the category label that meetings use across filters, reports and exports.</p>
        </div>
        <aside class="view-note">
            <div class="view-note-label">Category Note</div>
            <h2 class="view-note-title">Short meeting type labels improve scanability across the whole workspace.</h2>
            <ul class="view-note-list">
                <li><i class="bi bi-check2-circle"></i><span>Use clear names that teams can recognize instantly.</span></li>
                <li><i class="bi bi-check2-circle"></i><span>Remarks are useful only when the type needs extra context.</span></li>
            </ul>
        </aside>
    </section>

    <section class="view-card">
        <div class="view-card-header">
            <div>
                <h3 class="view-card-heading">Meeting Type Information</h3>
                <p class="view-card-meta">Core identity details for this meeting type label.</p>
            </div>
            <div class="view-actions">
                <a asp-action="MeetingsTypeAddEdit" asp-route-id="@Model.MeetingTypeID" class="btn view-btn view-btn-light">Edit</a>
                <form asp-action="Delete" method="post" class="d-inline js-delete-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="MeetingTypeID" value="@Model.MeetingTypeID" />
                    <button type="submit" class="btn view-btn view-btn-danger">Delete</button>
                </form>
            </div>
        </div>
        <div class="view-card-body">
            <div class="view-detail-grid">
                <div class="view-detail-item">
                    <span class="view-detail-label">Meeting Type ID</span>
                    <div class="view-detail-value">#@Model.MeetingTypeID</div>
                </div>
                <div class="view-detail-item">
                    <span class="view-detail-label">Meeting Type Name</span>
                    <div class="view-detail-value"><span class="view-badge">@Model.MeetingTypeName</span></div>
                </div>
                <div class="view-detail-item wide">
                    <span class="view-detail-label">Remarks</span>
                    <div class="view-detail-value muted">@(string.IsNullOrWhiteSpace(Model.Remarks) ? "-" : Model.Remarks)</div>
                </div>
            </div>
        </div>
    </section>
</div>
