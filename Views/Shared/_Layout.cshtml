@using Meeting_Of_Minutes.Models
@using Meeting_Of_Minutes.Services
<!DOCTYPE html>
<html lang="en">
@{
    AppShellViewModel shellModel = ViewData["AppShellModel"] as AppShellViewModel ?? ShellService.Build(Context, ViewContext.RouteData);
}
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>@ViewData["Title"] - Meeting Of Minutes</title>
    <link href="~/assets/img/favicon.png" rel="icon">
    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="~/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
    <link href="~/assets/vendor/boxicons/css/boxicons.min.css" rel="stylesheet">
    <link href="~/assets/vendor/simple-datatables/style.css" rel="stylesheet">
    <link href="~/assets/css/style.css" rel="stylesheet">
    <link href="~/css/mom-premium.css" rel="stylesheet">
    <link href="~/css/mom-modules.css" rel="stylesheet">
</head>
<body class="mom-app-shell">
    <div class="mom-shell-overlay" data-mom-sidebar-toggle></div>
    <div class="mom-shell">
        @await Html.PartialAsync("_Sidebar", shellModel)
        <div class="mom-shell-main">
            @await Html.PartialAsync("_Navbar", shellModel)
            @if (!string.IsNullOrWhiteSpace(shellModel.PlatformSettings.MaintenanceBanner))
            {
                <div class="mx-4 mt-3">
                    <div class="alert alert-warning border-0 shadow-sm rounded-4 mb-0">
                        <div class="d-flex align-items-start gap-3">
                            <i class="bi bi-megaphone fs-5"></i>
                            <div>
                                <div class="fw-bold">Platform Notice</div>
                                <div>@shellModel.PlatformSettings.MaintenanceBanner</div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            <main id="main" class="main mom-main">
                @RenderBody()
            </main>
            <footer class="footer border-0 bg-transparent text-center py-3">
                <div class="small text-muted">Meeting Of Minutes | premium operations workspace</div>
            </footer>
        </div>
    </div>

    <div class="modal fade mom-confirm-modal" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mom-confirm-icon mom-delete-icon">
                        <i class="bi bi-trash3-fill"></i>
                    </div>
                    <div class="mom-confirm-title">Delete Record?</div>
                    <p class="mom-confirm-text" id="deleteConfirmText">Sure to delete this record?</p>
                </div>
                <div class="modal-footer justify-content-center gap-2">
                    <button type="button" class="btn btn-light border" data-bs-dismiss="modal">No</button>
                    <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Yes, Delete</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade mom-confirm-modal" id="updateConfirmModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mom-confirm-icon mom-update-icon">
                        <i class="bi bi-pencil-square"></i>
                    </div>
                    <div class="mom-confirm-title">Update Record?</div>
                    <p class="mom-confirm-text" id="updateConfirmText">Sure to update this record?</p>
                </div>
                <div class="modal-footer justify-content-center gap-2">
                    <button type="button" class="btn btn-light border" data-bs-dismiss="modal">No</button>
                    <button type="button" class="btn btn-primary" id="confirmUpdateBtn">Yes, Update</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/vendor/simple-datatables/simple-datatables.js"></script>
    <script src="~/assets/js/main.js"></script>
    <script src="~/js/mom-premium.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>


