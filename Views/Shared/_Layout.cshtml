        }

        .mom-topbar-meta {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-left: 6px;
        }

        .mom-topbar-chip {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 12px;
