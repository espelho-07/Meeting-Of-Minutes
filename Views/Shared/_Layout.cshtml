            background: #f7f9fc;
            color: #67748a;
            border: 1px solid #e6ecf4;
            font-weight: 700;
            font-size: 0.8rem;
        }

        .mom-sidebar-stack {
            display: grid;
            gap: 6px;
        }

        .mom-sidebar-foot {
            margin-top: 24px;
            padding: 16px 14px;
            border-radius: 18px;
            background: #f7f9fd;
            border: 1px solid #e8edf5;
            color: #44516c;
        }

        .mom-sidebar-foot .small {
            color: #8b97ab !important;
        }

        .sidebar-nav {
            padding-top: 0;
            margin-top: 0;
        }

        .mom-confirm-modal .modal-content {
            border: 0;
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 24px 60px rgba(15, 23, 42, 0.25);
        }

        .mom-confirm-modal .modal-header {
            border: 0;
            padding: 1rem 1.25rem 0;
        }

        .mom-confirm-modal .modal-body {
            padding: 0 1.5rem 1.25rem;
            text-align: center;
        }

        .mom-confirm-modal .modal-footer {
            border: 0;
            justify-content: center;
            padding: 0 1.5rem 1.5rem;
            gap: 10px;
        }

        .mom-confirm-icon {
            width: 74px;
            height: 74px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            margin: 0 auto 1rem;
            font-size: 2rem;
        }

        .mom-delete-icon {
            background: linear-gradient(135deg, #ffe5e5, #ffd7d7);
            color: #dc3545;
        }

        .mom-update-icon {
            background: linear-gradient(135deg, #e6f0ff, #dbeafe);
            color: #2563eb;
        }

        .mom-confirm-title {
            font-weight: 700;
            font-size: 1.25rem;
            color: #1f2937;
            margin-bottom: 0.35rem;
        }

        .mom-confirm-text {
            color: #6b7280;
            font-size: 0.95rem;
            margin-bottom: 0;
        }

        .mom-confirm-btn {
            min-width: 120px;
            border-radius: 12px;
            padding: 0.65rem 1.25rem;
            font-weight: 600;
        }

        @@media (max-width: 991px) {
            .header {
                padding: 0 10px;
            }

            .header .logo {
                min-width: auto;
                padding: 0;
            }

            .sidebar {
                padding-left: 10px;
                padding-right: 10px;
            }

            .main {
                padding: 20px 14px 28px;
            }

            .mom-detail-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

    <!-- ======= Header ======= -->
    <header id="header" class="header fixed-top d-flex align-items-center">

        <div class="d-flex align-items-center justify-content-between">
            <i class="bi bi-list toggle-sidebar-btn"></i>
            <div class="mom-shell-title">
                <strong>@(currentController == "DashBoard" ? "Dashboard" : currentController)</strong>
                <span>@(isAdminUser ? "Admin control surface" : "User workspace")</span>
            </div>
            <div class="mom-topbar-meta d-none d-xl-flex">
                <div class="mom-topbar-chip">
                    <i class="bi bi-grid-1x2"></i>
                    @(isAdminUser ? "Admin Workspace" : "User Workspace")
                </div>
                <div class="mom-topbar-chip">
                    <i class="bi bi-building"></i>
                    @(string.IsNullOrWhiteSpace(Context.Session.GetString("CompanyName")) ? "No Company" : Context.Session.GetString("CompanyName"))
                </div>
            </div>
        </div>

        <nav class="header-nav ms-auto">
            <ul class="d-flex align-items-center">

                @if (isAdminUser)
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link nav-icon" href="#" data-bs-toggle="dropdown">
                            <i class="bi bi-bell"></i>
                            @if (unreadNotificationCount > 0)
                            {
                                <span class="badge bg-primary badge-number">@unreadNotificationCount</span>
                            }
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end dropdown-menu-arrow notifications">
                            <li class="dropdown-header">
                                @(layoutNotifications.Count == 0 ? "No new notifications" : $"You have {unreadNotificationCount} unread notifications")
                            </li>
                            @if (layoutNotifications.Count > 0)
                            {
                                <li class="mom-notification-tools">
                                    <div class="mom-notification-status">@(unreadNotificationCount > 0 ? $"{unreadNotificationCount} unread" : "All read")</div>
                                    <div class="mom-notification-actions">
                                        <form asp-controller="Profile" asp-action="MarkAllNotificationsRead" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit">Mark all read</button>
                                        </form>
                                        <form asp-controller="Profile" asp-action="ClearAllNotifications" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit">Clear all</button>
                                        </form>
                                    </div>
                                </li>
                            }
                            <li><hr class="dropdown-divider"></li>
                            @if (layoutNotifications.Count == 0)
                            {
                                <li class="notification-item">
                                    <i class="bi bi-bell"></i>
                                    <div>
                                        <h4>All clear</h4>
                                        <p>No recent admin notifications found.</p>
                                    </div>
                                </li>
                            }
                            else
                            {
                                @foreach (var notification in layoutNotifications.Take(5))
                                {
                                    string targetController = notification.NotificationType == "StaffTransferRequest" ? "Staff" : "Profile";
                                    string targetAction = notification.NotificationType == "PasswordChanged"
                                        ? "Profile"
                                        : notification.NotificationType == "StaffTransferRequest"
                                            ? "StaffTransferRequestList"
                                            : "ProfileUpdateRequestList";
                                    <li>
                                        <a class="notification-item text-decoration-none @(notification.IsRead ? "is-read" : string.Empty)" asp-controller="@targetController" asp-action="@targetAction">
                                            <i class="bi @(notification.NotificationType == "PasswordChanged" ? "bi-key" : notification.NotificationType == "StaffTransferRequest" ? "bi-arrow-left-right" : "bi-person-lines-fill")"></i>
                                            <div>
                                                <h4>@notification.Title</h4>
                                                <p>@notification.Message</p>
                                                <p>@notification.Created.ToString("dd MMM yyyy hh:mm tt")</p>
                                            </div>
                                        </a>
                                    </li>
                                }
                            }
                        </ul>
                    </li>
                }

                <!-- Profile -->
                <li class="nav-item dropdown pe-3">

                    <a class="nav-link nav-profile d-flex align-items-center pe-0" href="#" data-bs-toggle="dropdown">
                        <img src="~/assets/img/profile-img.jpg" alt="Profile" class="rounded-circle">
                        <span class="d-none d-md-block dropdown-toggle ps-2">@Context.Session.GetString("UserName")</span>
                    </a><!-- End Profile Iamge Icon -->

                    <ul class="dropdown-menu dropdown-menu-end dropdown-menu-arrow profile">
                        <li class="dropdown-header">
                            <h6>@Context.Session.GetString("UserName")</h6>
                            <span>@currentUserRole</span>
                        </li>
                        <li>
                            <hr class="dropdown-divider">
                        </li>

                        <li>
                            <a class="dropdown-item d-flex align-items-center" asp-controller="Profile" asp-action="Profile">
                                <i class="bi bi-person"></i>
                                <span>My Profile</span>
                            </a>
                        </li>
                        <li>
                            <hr class="dropdown-divider">
                        </li>

                        <li>
                            <a class="dropdown-item d-flex align-items-center" asp-controller="Auth" asp-action="Logout">
                                <i class="bi bi-box-arrow-right"></i>
                                <span>Sign Out</span>
                            </a>
                        </li>

                    </ul><!-- End Profile Dropdown Items -->
                </li><!-- End Profile Nav -->
            </ul>
        </nav>
    </header>
    <!-- End Header -->
    <!-- ======= Sidebar ======= -->
