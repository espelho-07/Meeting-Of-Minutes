<style>
    .list-page {
        max-width: 1120px;
        margin: 0 auto;
    }

    .list-hero {
        display: grid;
        grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.75fr);
        gap: 18px;
        align-items: stretch;
        margin-bottom: 24px;
    }

    .list-hero-main {
        position: relative;
        overflow: hidden;
        border-radius: 26px;
        padding: 30px 32px;
        background: linear-gradient(135deg, #eef2ff 0%, #f7f4ff 48%, #ffffff 100%);
        border: 1px solid rgba(120, 102, 255, 0.14);
        box-shadow: 0 24px 60px rgba(54, 63, 121, 0.10);
    }

    .list-hero-main::before,
    .list-hero-main::after {
        content: "";
        position: absolute;
        border-radius: 999px;
        pointer-events: none;
    }

    .list-hero-main::before {
        width: 240px;
        height: 240px;
        right: -70px;
        top: -110px;
        background: radial-gradient(circle, rgba(108, 99, 255, 0.20) 0%, rgba(108, 99, 255, 0) 70%);
    }

    .list-hero-main::after {
        width: 180px;
        height: 180px;
        left: -50px;
        bottom: -80px;
        background: radial-gradient(circle, rgba(139, 92, 246, 0.16) 0%, rgba(139, 92, 246, 0) 70%);
    }

    .list-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 12px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.72);
        border: 1px solid rgba(114, 97, 255, 0.12);
        color: #5b59d9;
        font-size: 0.74rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin-bottom: 16px;
        position: relative;
        z-index: 1;
    }

    .list-title {
        margin: 0 0 12px;
        color: #18233f;
        font-size: clamp(2.1rem, 3.6vw, 3.25rem);
        line-height: 0.98;
        font-weight: 900;
        letter-spacing: -0.05em;
        max-width: 12ch;
        position: relative;
        z-index: 1;
    }

    .list-subtitle {
        margin: 0;
        max-width: 58ch;
        font-size: 1rem;
        line-height: 1.75;
        color: #60708d;
        position: relative;
        z-index: 1;
    }

    .list-note {
        display: grid;
        gap: 14px;
        align-content: start;
        background: rgba(255, 255, 255, 0.86);
        border: 1px solid #e8ebf8;
        border-radius: 24px;
        padding: 24px;
        box-shadow: 0 18px 40px rgba(44, 52, 92, 0.08);
    }

    .list-note-label {
        color: #8996ab;
        font-size: 0.74rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }

    .list-note-title {
        margin: 0;
        color: #1e2a48;
        font-size: 1.45rem;
        line-height: 1.2;
        font-weight: 800;
        letter-spacing: -0.03em;
    }

    .list-note-list {
        display: grid;
        gap: 10px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .list-note-list li {
        display: flex;
        gap: 10px;
        align-items: flex-start;
        color: #66748f;
        font-size: 0.95rem;
        line-height: 1.6;
    }

    .list-note-list i {
        color: #6658f2;
        margin-top: 3px;
    }

    .list-surface {
        background: rgba(255, 255, 255, 0.96);
        border: 1px solid #e9edf7;
        border-radius: 28px;
        box-shadow: 0 24px 60px rgba(32, 41, 76, 0.08);
        overflow: hidden;
    }

    .list-surface-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 24px 28px 18px;
        border-bottom: 1px solid #edf1f8;
        flex-wrap: wrap;
    }

    .list-surface-heading {
        margin: 0;
        color: #1b2747;
        font-size: 1.2rem;
        font-weight: 800;
        letter-spacing: -0.02em;
    }

    .list-surface-meta {
        margin: 6px 0 0;
        color: #7b88a0;
        font-size: 0.92rem;
    }

    .list-status-chip {
        padding: 8px 12px;
        border-radius: 999px;
        background: #f5f6ff;
        color: #5d5ae6;
        border: 1px solid #e3e6ff;
        font-size: 0.78rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .list-search-wrap {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 22px 28px 0;
        flex-wrap: wrap;
    }

    .list-search-form {
        display: flex;
        gap: 12px;
        align-items: center;
        flex-wrap: wrap;
        width: min(100%, 760px);
    }

    .list-search-input {
        flex: 1 1 320px;
        min-width: 240px;
        display: flex;
        align-items: center;
        border: 1px solid #e1e7f2;
        border-radius: 18px;
        background: #fbfcff;
        min-height: 56px;
        overflow: hidden;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .list-search-input:focus-within {
        border-color: rgba(99, 91, 255, 0.55);
        box-shadow: 0 0 0 4px rgba(99, 91, 255, 0.10);
        background: #fff;
    }

    .list-search-input span {
        width: 54px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #6d7c97;
        background: linear-gradient(180deg, #fbfbff 0%, #f3f6ff 100%);
        border-right: 1px solid #e5eaf4;
        font-size: 1rem;
        flex-shrink: 0;
    }

    .list-search-input .form-control {
        border: 0;
        border-radius: 0;
        background: transparent;
        min-height: 56px;
        font-size: 1rem;
        color: #1d2742;
        padding: 14px 16px;
        box-shadow: none;
    }

    .list-btn {
        min-height: 48px;
        padding: 0 20px;
        border-radius: 14px;
        font-weight: 800;
        font-size: 0.94rem;
    }

    .list-btn-primary {
        border: 0;
        color: #fff;
        background: linear-gradient(135deg, #635bff 0%, #7a4dce 100%);
        box-shadow: 0 16px 30px rgba(99, 91, 255, 0.20);
    }

    .list-btn-light {
        border: 1px solid #dbe3ef;
        background: #fff;
        color: #273350;
        box-shadow: 0 8px 18px rgba(38, 46, 78, 0.05);
    }

    .list-btn-success {
        border: 0;
        background: #178b57;
        color: #fff;
    }

    .list-table-wrap {
        padding: 22px 28px 28px;
    }

    .list-table-card {
        border: 1px solid #edf1f8;
        border-radius: 22px;
        overflow: hidden;
        background: #fff;
    }

    .list-table-card .table {
        margin: 0;
    }

    .list-table-card thead th {
        background: #fafbff !important;
        color: #52617d !important;
        font-size: 0.77rem;
        font-weight: 800;
        letter-spacing: 0.03em;
        border-bottom: 1px solid #e8edf5;
        padding: 0.9rem 1rem;
    }

    .list-table-card tbody td {
        padding: 0.92rem 1rem;
        vertical-align: middle;
        border-bottom-color: #edf1f7;
        font-size: 0.93rem;
    }

    .list-table-card tbody tr:hover {
        background: #fafbff;
    }

    .list-empty {
        padding: 28px;
        text-align: center;
        color: #8390a7;
        font-weight: 600;
    }

    @@media (max-width: 991px) {
        .list-page {
            max-width: 100%;
        }

        .list-hero {
            grid-template-columns: 1fr;
        }

        .list-hero-main,
        .list-note,
        .list-surface-header,
        .list-search-wrap,
        .list-table-wrap {
            padding-left: 22px;
            padding-right: 22px;
        }

        .list-title {
            max-width: none;
            font-size: 2.3rem;
        }
    }
</style>
