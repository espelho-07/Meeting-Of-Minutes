@{
    var successMessage = TempData["SuccessMessage"]?.ToString() ?? TempData["SucessMessage"]?.ToString();
    var errorMessage = TempData["ErrorMessage"]?.ToString();
    var deleteError = TempData["DeleteError"]?.ToString();
    var importReportPath = TempData["ImportReportPath"]?.ToString();
}

@if (!string.IsNullOrWhiteSpace(successMessage) || !string.IsNullOrWhiteSpace(errorMessage) || !string.IsNullOrWhiteSpace(deleteError))
{
    <div class="mom-inline-alerts">
        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="alert alert-success alert-dismissible fade show mom-alert-box mom-alert-success" role="alert">
                <div class="mom-alert-body">
                    <div class="mom-alert-icon">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                    <div class="mom-alert-copy">
                        <div class="mom-alert-kicker">Success</div>
                        <div class="mom-alert-text">@successMessage</div>
                        @if (!string.IsNullOrWhiteSpace(importReportPath))
                        {
                            <div class="mom-alert-actions">
                                <a href="@importReportPath" class="btn btn-sm btn-light border">
                                    <i class="bi bi-download me-2"></i>Download Import Report
                                </a>
                            </div>
                        }
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show mom-alert-box mom-alert-danger" role="alert">
                <div class="mom-alert-body">
                    <div class="mom-alert-icon">
                        <i class="bi bi-x-circle-fill"></i>
                    </div>
                    <div class="mom-alert-copy">
                        <div class="mom-alert-kicker">Error</div>
                        <div class="mom-alert-text">@errorMessage</div>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(deleteError))
        {
            <div class="alert alert-warning alert-dismissible fade show mom-alert-box mom-alert-warning" role="alert">
                <div class="mom-alert-body">
                    <div class="mom-alert-icon">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                    </div>
                    <div class="mom-alert-copy">
                        <div class="mom-alert-kicker">Warning</div>
                        <div class="mom-alert-text">@deleteError</div>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>
}
