<style>
    .form-page {
        max-width: 1120px;
        margin: 0 auto;
    }

    .form-hero {
        display: grid;
        grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.75fr);
        gap: 18px;
        align-items: stretch;
        margin-bottom: 24px;
    }

    .form-hero-main {
        position: relative;
        overflow: hidden;
        border-radius: 26px;
        padding: 30px 32px;
        background: linear-gradient(135deg, #eef2ff 0%, #f7f4ff 48%, #ffffff 100%);
        border: 1px solid rgba(120, 102, 255, 0.14);
        box-shadow: 0 24px 60px rgba(54, 63, 121, 0.10);
    }

    .form-hero-main::before,
    .form-hero-main::after {
        content: "";
        position: absolute;
        border-radius: 999px;
        pointer-events: none;
    }

    .form-hero-main::before {
        width: 240px;
        height: 240px;
        right: -70px;
        top: -110px;
        background: radial-gradient(circle, rgba(108, 99, 255, 0.20) 0%, rgba(108, 99, 255, 0) 70%);
    }

    .form-hero-main::after {
        width: 180px;
        height: 180px;
        left: -50px;
        bottom: -80px;
        background: radial-gradient(circle, rgba(139, 92, 246, 0.16) 0%, rgba(139, 92, 246, 0) 70%);
    }

    .form-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 12px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.72);
        border: 1px solid rgba(114, 97, 255, 0.12);
        color: #5b59d9;
        font-size: 0.74rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin-bottom: 16px;
        position: relative;
        z-index: 1;
    }

    .form-title {
        margin: 0 0 12px;
        color: #18233f;
        font-size: clamp(2.3rem, 4vw, 3.5rem);
        line-height: 0.98;
        font-weight: 900;
        letter-spacing: -0.05em;
        max-width: 11ch;
        position: relative;
        z-index: 1;
    }

    .form-subtitle {
        margin: 0;
        max-width: 58ch;
        font-size: 1.02rem;
        line-height: 1.75;
        color: #60708d;
        position: relative;
        z-index: 1;
    }

    .form-note {
        display: grid;
        gap: 14px;
        align-content: start;
        background: rgba(255, 255, 255, 0.86);
        border: 1px solid #e8ebf8;
        border-radius: 24px;
        padding: 24px;
        box-shadow: 0 18px 40px rgba(44, 52, 92, 0.08);
    }

    .form-note-label {
        color: #8996ab;
        font-size: 0.74rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }

    .form-note-title {
        margin: 0;
        color: #1e2a48;
        font-size: 1.45rem;
        line-height: 1.2;
        font-weight: 800;
        letter-spacing: -0.03em;
    }

    .form-note-list {
        display: grid;
        gap: 10px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .form-note-list li {
        display: flex;
        gap: 10px;
        align-items: flex-start;
        color: #66748f;
        font-size: 0.95rem;
        line-height: 1.6;
    }

    .form-note-list i {
        color: #6658f2;
        margin-top: 3px;
    }

    .form-card {
        background: rgba(255, 255, 255, 0.96);
        border: 1px solid #e9edf7;
        border-radius: 28px;
        box-shadow: 0 24px 60px rgba(32, 41, 76, 0.08);
        overflow: hidden;
    }

    .form-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 24px 28px 18px;
        border-bottom: 1px solid #edf1f8;
    }

    .form-card-heading {
        margin: 0;
        color: #1b2747;
        font-size: 1.2rem;
        font-weight: 800;
        letter-spacing: -0.02em;
    }

    .form-card-meta {
        margin: 6px 0 0;
        color: #7b88a0;
        font-size: 0.92rem;
    }

    .form-status-chip {
        padding: 8px 12px;
        border-radius: 999px;
        background: #f5f6ff;
        color: #5d5ae6;
        border: 1px solid #e3e6ff;
        font-size: 0.78rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .form-card-body {
        padding: 28px;
    }

    .form-field {
        display: grid;
        gap: 10px;
    }

    .form-label-modern {
        color: #33415c;
        font-size: 0.92rem;
        font-weight: 700;
        letter-spacing: -0.01em;
    }

    .form-input-shell {
        display: flex;
        align-items: stretch;
        border: 1px solid #e1e7f2;
        border-radius: 20px;
        background: #fbfcff;
        min-height: 60px;
        overflow: hidden;
        transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
    }

    .form-input-shell:focus-within {
        border-color: rgba(99, 91, 255, 0.55);
        box-shadow: 0 0 0 4px rgba(99, 91, 255, 0.10);
        transform: translateY(-1px);
        background: #fff;
    }

    .form-input-icon {
        width: 58px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #6d7c97;
        background: linear-gradient(180deg, #fbfbff 0%, #f3f6ff 100%);
        border-right: 1px solid #e5eaf4;
        font-size: 1rem;
        flex-shrink: 0;
    }

    .form-input-shell .form-control,
    .form-input-shell .form-select {
        border: 0;
        border-radius: 0;
        background: transparent;
        min-height: 60px;
        font-size: 1rem;
        color: #1d2742;
        padding: 16px 18px;
        box-shadow: none;
    }

    .form-input-shell textarea.form-control {
        min-height: 130px;
        resize: vertical;
        padding-top: 16px;
    }

    .form-check-modern {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 14px;
        border-radius: 16px;
        background: #f8faff;
        border: 1px solid #e7edf7;
    }

    .form-check-modern .form-check-input {
        float: none;
        margin: 0;
        width: 18px;
        height: 18px;
    }

    .form-check-modern .form-check-label {
        margin: 0;
        color: #55637d;
        font-size: 0.92rem;
    }

    .form-help {
        color: #8390a7;
        font-size: 0.84rem;
        line-height: 1.55;
        margin: 0;
    }

    .form-actions-modern {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 12px;
        padding-top: 8px;
    }

    .form-btn {
        min-height: 50px;
        padding: 0 22px;
        border-radius: 16px;
        font-weight: 800;
        font-size: 0.95rem;
        transition: transform 0.18s ease, box-shadow 0.18s ease;
    }

    .form-btn:hover {
        transform: translateY(-1px);
    }

    .form-btn-outline {
        border: 1px solid #dbe3ef;
        background: #fff;
        color: #273350;
        box-shadow: 0 8px 18px rgba(38, 46, 78, 0.05);
    }

    .form-btn-primary {
        border: 0;
        color: #fff;
        background: linear-gradient(135deg, #635bff 0%, #7a4dce 100%);
        box-shadow: 0 16px 30px rgba(99, 91, 255, 0.24);
    }

    .form-btn-spinner {
        display: none;
    }

    .form-btn.is-loading .form-btn-spinner {
        display: inline-block;
    }

    .field-validation-error,
    .text-danger {
        color: #dc3545 !important;
        font-size: 0.82rem;
        font-weight: 600;
    }

    @@media (max-width: 991px) {
        .form-page {
            max-width: 100%;
        }

        .form-hero {
            grid-template-columns: 1fr;
        }

        .form-hero-main,
        .form-note,
        .form-card-body,
        .form-card-header {
            padding: 22px;
        }

        .form-title {
            max-width: none;
            font-size: 2.35rem;
        }
    }

    @@media (max-width: 575px) {
        .form-actions-modern {
            flex-direction: column-reverse;
            align-items: stretch;
        }

        .form-btn {
            width: 100%;
        }
    }
</style>
