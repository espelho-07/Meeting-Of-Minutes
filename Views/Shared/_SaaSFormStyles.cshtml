<style>
    .form-page {
        width: min(100%, 1320px);
        margin: 0;
    }

    .form-hero {
        display: grid;
        grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.7fr);
        gap: 16px;
        align-items: stretch;
        margin-bottom: 18px;
    }

    .form-hero-main {
        position: relative;
        overflow: hidden;
        border-radius: 24px;
        padding: 24px 26px;
        background: linear-gradient(135deg, #eef2ff 0%, #f7f4ff 48%, #ffffff 100%);
        border: 1px solid rgba(120, 102, 255, 0.14);
        box-shadow: 0 18px 44px rgba(54, 63, 121, 0.08);
    }

    .form-hero-main::before,
    .form-hero-main::after {
        content: "";
        position: absolute;
        border-radius: 999px;
        pointer-events: none;
    }

    .form-hero-main::before {
        width: 210px;
        height: 210px;
        right: -54px;
        top: -94px;
        background: radial-gradient(circle, rgba(108, 99, 255, 0.18) 0%, rgba(108, 99, 255, 0) 70%);
    }

    .form-hero-main::after {
        width: 160px;
        height: 160px;
        left: -42px;
        bottom: -72px;
        background: radial-gradient(circle, rgba(139, 92, 246, 0.14) 0%, rgba(139, 92, 246, 0) 70%);
    }

    .form-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 7px 11px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.74);
        border: 1px solid rgba(114, 97, 255, 0.12);
        color: #5b59d9;
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin-bottom: 14px;
        position: relative;
        z-index: 1;
    }

    .form-title {
        margin: 0 0 10px;
        color: #18233f;
        font-size: clamp(2rem, 3vw, 2.9rem);
        line-height: 1.02;
        font-weight: 900;
        letter-spacing: -0.05em;
        max-width: 10ch;
        position: relative;
        z-index: 1;
    }

    .form-subtitle {
        margin: 0;
        max-width: 56ch;
        font-size: 0.98rem;
        line-height: 1.65;
        color: #60708d;
        position: relative;
        z-index: 1;
    }

    .form-note {
        display: grid;
        gap: 12px;
        align-content: start;
        background: rgba(255, 255, 255, 0.88);
        border: 1px solid #e8ebf8;
        border-radius: 22px;
        padding: 20px;
        box-shadow: 0 14px 34px rgba(44, 52, 92, 0.07);
    }

    .form-note-label {
        color: #8996ab;
        font-size: 0.72rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }

    .form-note-title {
        margin: 0;
        color: #1e2a48;
        font-size: 1.2rem;
        line-height: 1.22;
        font-weight: 800;
        letter-spacing: -0.03em;
    }

    .form-note-list {
        display: grid;
        gap: 9px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .form-note-list li {
        display: flex;
        gap: 10px;
        align-items: flex-start;
        color: #66748f;
        font-size: 0.92rem;
        line-height: 1.55;
    }

    .form-note-list i {
        color: #6658f2;
        margin-top: 3px;
    }

    .form-card {
        background: rgba(255, 255, 255, 0.96);
        border: 1px solid #e9edf7;
        border-radius: 24px;
        box-shadow: 0 18px 44px rgba(32, 41, 76, 0.07);
        overflow: hidden;
    }

    .form-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        padding: 18px 22px 14px;
        border-bottom: 1px solid #edf1f8;
    }

    .form-card-heading {
        margin: 0;
        color: #1b2747;
        font-size: 1.08rem;
        font-weight: 800;
        letter-spacing: -0.02em;
    }

    .form-card-meta {
        margin: 4px 0 0;
        color: #7b88a0;
        font-size: 0.88rem;
    }

    .form-status-chip {
        padding: 7px 11px;
        border-radius: 999px;
        background: #f5f6ff;
        color: #5d5ae6;
        border: 1px solid #e3e6ff;
        font-size: 0.75rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .form-card-body {
        padding: 22px;
    }

    .validation-summary-errors {
        margin-bottom: 18px;
        padding: 14px 16px;
        border-radius: 18px;
        border: 1px solid #ffd6dc;
        background: linear-gradient(180deg, #fff7f8 0%, #fff2f4 100%);
        color: #b42318;
        box-shadow: 0 10px 24px rgba(180, 35, 24, 0.06);
    }

    .validation-summary-errors ul {
        margin: 8px 0 0;
        padding-left: 18px;
    }

    .field-validation-error {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-top: 2px;
        color: #b42318;
        font-size: 0.82rem;
        font-weight: 700;
    }

    .field-validation-error::before {
        content: "!";
        width: 18px;
        height: 18px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(180, 35, 24, 0.1);
        font-size: 0.72rem;
        font-weight: 800;
    }

    .input-validation-error,
    .form-input-shell .input-validation-error {
        border-color: #f04438 !important;
        background: #fffafb !important;
    }

    .form-field {
        display: grid;
        gap: 8px;
    }

    .form-label-modern {
        color: #33415c;
        font-size: 0.88rem;
        font-weight: 700;
        letter-spacing: -0.01em;
    }

    .form-input-shell {
        display: flex;
        align-items: stretch;
        border: 1px solid #e1e7f2;
        border-radius: 18px;
        background: #fbfcff;
        min-height: 54px;
        overflow: hidden;
        transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
    }

    .form-input-shell:focus-within {
        border-color: rgba(99, 91, 255, 0.55);
        box-shadow: 0 0 0 4px rgba(99, 91, 255, 0.10);
        transform: translateY(-1px);
        background: #fff;
    }

    .form-input-icon {
        width: 50px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #6d7c97;
        background: linear-gradient(180deg, #fbfbff 0%, #f3f6ff 100%);
        border-right: 1px solid #e5eaf4;
        font-size: 0.96rem;
        flex-shrink: 0;
    }

    .form-input-shell .form-control,
    .form-input-shell .form-select {
        border: 0;
        border-radius: 0;
        background: transparent;
        min-height: 54px;
        font-size: 0.96rem;
        color: #1d2742;
        padding: 14px 16px;
        box-shadow: none;
    }

    .form-input-shell textarea.form-control {
        min-height: 118px;
        resize: vertical;
        padding-top: 14px;
    }

    .form-check-modern {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 14px;
        border-radius: 16px;
        background: #f8faff;
        border: 1px solid #e7edf7;
    }

    .form-check-modern .form-check-input {
        float: none;
        margin: 0;
        width: 18px;
        height: 18px;
    }

    .form-check-modern .form-check-label {
        margin: 0;
        color: #55637d;
        font-size: 0.9rem;
    }

    .form-help {
        color: #8390a7;
        font-size: 0.82rem;
        line-height: 1.5;
        margin: 0;
    }

    .form-actions-modern {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
        padding-top: 8px;
    }

    .form-section-grid {
        display: grid;
        gap: 18px;
    }

    .form-section-divider {
        height: 1px;
        background: linear-gradient(90deg, transparent 0%, #e8ecf4 12%, #e8ecf4 88%, transparent 100%);
        margin: 4px 0;
    }

    .form-section-title {
        margin: 0;
        color: #192443;
        font-size: 1rem;
        font-weight: 800;
        letter-spacing: -0.02em;
    }

    .form-section-meta {
        margin: 4px 0 0;
        color: #7a879d;
        font-size: 0.88rem;
        line-height: 1.55;
    }

    @@media (max-width: 991px) {
        .form-page {
            width: 100%;
        }

        .form-hero {
            grid-template-columns: 1fr;
        }

        .form-hero-main,
        .form-note,
        .form-card-header,
        .form-card-body {
            padding: 20px;
        }

        .form-title {
            max-width: none;
            font-size: 2.2rem;
        }
    }

    body.mom-theme-dark .validation-summary-errors {
        border-color: rgba(251, 113, 133, 0.22);
        background: linear-gradient(180deg, rgba(127, 29, 29, 0.22) 0%, rgba(69, 10, 10, 0.16) 100%);
        color: #fecdd3;
    }

    body.mom-theme-dark .field-validation-error {
        color: #fecdd3;
    }

    body.mom-theme-dark .field-validation-error::before {
        background: rgba(251, 113, 133, 0.16);
    }

    body.mom-theme-dark .input-validation-error,
    body.mom-theme-dark .form-input-shell .input-validation-error {
        background: rgba(127, 29, 29, 0.14) !important;
        border-color: rgba(251, 113, 133, 0.3) !important;
    }
</style>
