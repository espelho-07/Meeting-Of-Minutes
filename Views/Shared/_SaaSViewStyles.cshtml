    .view-note-label { color: #8996ab; font-size: .74rem; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; }
    .view-note-title { margin: 0; color: #1e2a48; font-size: 1.35rem; line-height: 1.2; font-weight: 800; letter-spacing: -.03em; }
