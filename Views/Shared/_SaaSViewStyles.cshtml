<style>
    .view-page { max-width: 1120px; margin: 0 auto; }
    .view-hero { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.75fr); gap: 18px; align-items: stretch; margin-bottom: 24px; }
    .view-hero-main { position: relative; overflow: hidden; border-radius: 26px; padding: 30px 32px; background: linear-gradient(135deg, #eef2ff 0%, #f7f4ff 48%, #ffffff 100%); border: 1px solid rgba(120, 102, 255, 0.14); box-shadow: 0 24px 60px rgba(54, 63, 121, 0.10); }
    .view-hero-main::before, .view-hero-main::after { content: ""; position: absolute; border-radius: 999px; pointer-events: none; }
    .view-hero-main::before { width: 240px; height: 240px; right: -70px; top: -110px; background: radial-gradient(circle, rgba(108, 99, 255, 0.20) 0%, rgba(108, 99, 255, 0) 70%); }
    .view-hero-main::after { width: 180px; height: 180px; left: -50px; bottom: -80px; background: radial-gradient(circle, rgba(139, 92, 246, 0.16) 0%, rgba(139, 92, 246, 0) 70%); }
    .view-kicker { display: inline-flex; align-items: center; gap: 8px; padding: 8px 12px; border-radius: 999px; background: rgba(255,255,255,.72); border: 1px solid rgba(114,97,255,.12); color: #5b59d9; font-size: .74rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; margin-bottom: 16px; position: relative; z-index: 1; }
    .view-title { margin: 0 0 12px; color: #18233f; font-size: clamp(2.2rem, 4vw, 3.3rem); line-height: .98; font-weight: 900; letter-spacing: -.05em; max-width: 12ch; position: relative; z-index: 1; }
    .view-subtitle { margin: 0; max-width: 58ch; font-size: 1rem; line-height: 1.75; color: #60708d; position: relative; z-index: 1; }
