    .view-note-list i { color: #6658f2; margin-top: 3px; }
    .view-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 18px; margin-bottom: 20px; }
    .view-card { background: rgba(255,255,255,.96); border: 1px solid #e9edf7; border-radius: 28px; box-shadow: 0 24px 60px rgba(32,41,76,.08); overflow: hidden; }
    .view-card-header { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 22px 26px 16px; border-bottom: 1px solid #edf1f8; }
    .view-card-heading { margin: 0; color: #1b2747; font-size: 1.12rem; font-weight: 800; letter-spacing: -.02em; }
    .view-card-meta { margin: 6px 0 0; color: #7b88a0; font-size: .9rem; }
    .view-card-body { padding: 26px; }
