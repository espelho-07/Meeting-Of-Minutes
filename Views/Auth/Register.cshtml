@model Meeting_Of_Minutes.Models.RegisterModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Company Super Admin Sign Up | Meeting Of Minutes</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        :root {
            --mom-bg: #eff3f9;
            --mom-surface: rgba(255,255,255,0.95);
            --mom-border: #dde4f0;
            --mom-text: #172033;
            --mom-muted: #6f7d95;
            --mom-accent: #5b5ce6;
            --mom-shadow: 0 24px 60px rgba(19, 28, 53, 0.12);
        }

        body {
            min-height: 100vh;
            margin: 0;
            background:
                radial-gradient(circle at top left, rgba(91,92,230,0.15), transparent 24%),
                radial-gradient(circle at bottom right, rgba(91,92,230,0.11), transparent 22%),
                linear-gradient(180deg, #f8fafc 0%, var(--mom-bg) 100%);
            font-family: "Nunito", sans-serif;
        }

        .auth-shell {
            min-height: 100vh;
            display: grid;
            grid-template-columns: 0.95fr 1.05fr;
            gap: 24px;
            padding: 28px;
        }

        .auth-stage,
        .auth-panel {
            border-radius: 32px;
            border: 1px solid rgba(221,228,240,0.9);
            overflow: hidden;
            box-shadow: var(--mom-shadow);
        }

        .auth-stage {
            background: linear-gradient(160deg, #151c41 0%, #24306a 48%, #5963e8 100%);
            color: #fff;
            padding: 42px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .auth-brand {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            font-weight: 800;
        }

        .auth-brand-badge {
            width: 46px;
            height: 46px;
            border-radius: 16px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: rgba(255,255,255,0.14);
            border: 1px solid rgba(255,255,255,0.18);
        }

        .auth-stage h1 {
            font-size: clamp(2.4rem, 3.8vw, 4rem);
            line-height: 1;
            font-weight: 900;
            margin: 0 0 14px;
            max-width: 540px;
        }

        .auth-stage p {
            color: rgba(255,255,255,0.76);
            max-width: 520px;
            margin: 0;
        }

        .auth-points {
            display: grid;
            gap: 12px;
            margin-top: 28px;
        }

        .auth-point {
            display: flex;
            gap: 12px;
            align-items: flex-start;
            padding: 16px 18px;
            border-radius: 20px;
            background: rgba(255,255,255,0.10);
            border: 1px solid rgba(255,255,255,0.12);
        }

        .auth-point i {
            font-size: 1.1rem;
            margin-top: 2px;
        }

        .auth-panel {
            background: var(--mom-surface);
            backdrop-filter: blur(18px);
            padding: 28px;
            display: flex;
            align-items: center;
        }

        .auth-card {
            width: 100%;
            max-width: 640px;
            margin: 0 auto;
        }

        .auth-eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            border-radius: 999px;
            padding: 8px 12px;
            background: #eef1ff;
            color: var(--mom-accent);
            font-weight: 800;
            margin-bottom: 18px;
        }

        .auth-title {
            font-size: 2.25rem;
            line-height: 1;
            font-weight: 900;
            color: var(--mom-text);
            margin-bottom: 10px;
        }

        .auth-subtitle {
            color: var(--mom-muted);
            margin-bottom: 24px;
        }

        .auth-label {
            font-size: 0.84rem;
            font-weight: 800;
            color: #44516c;
            margin-bottom: 6px;
        }

        .auth-control {
            min-height: 54px;
            border-radius: 16px;
            border: 1px solid var(--mom-border);
            background: #fff;
            box-shadow: none !important;
        }

        .auth-input-group .input-group-text {
            background: #fff;
            border-color: var(--mom-border);
            min-height: 54px;
            border-radius: 16px 0 0 16px !important;
            color: #93a0b8;
        }

        .auth-input-group .form-control {
            border-left: 0;
            border-right: 0;
            border-radius: 0 !important;
        }

        .auth-input-group .toggle-eye {
            cursor: pointer;
            border-left: 0;
            border-radius: 0 16px 16px 0 !important;
        }

        .auth-rulebox {
            background: #fbfcff;
            border: 1px solid #e9edf6;
            border-radius: 20px;
            padding: 16px 18px;
        }

        .rule { font-size: 13px; color: #6c7a92; }
        .rule.ok { color: #198754; font-weight: 700; }

        .auth-submit {
            background: linear-gradient(90deg, #4f5bea 0%, #6672ff 100%);
            border: 0;
            border-radius: 16px;
            min-height: 54px;
            font-weight: 800;
            box-shadow: 0 18px 30px rgba(91, 92, 230, 0.22);
        }

        .auth-link, .auth-link:hover {
            color: var(--mom-accent);
            text-decoration: none;
            font-weight: 800;
        }

        @@media (max-width: 1100px) {
            .auth-shell { grid-template-columns: 1fr; }
        }

        @@media (max-width: 767px) {
            .auth-shell { padding: 16px; }
            .auth-stage, .auth-panel { border-radius: 24px; }
            .auth-stage { padding: 24px; }
            .auth-panel { padding: 18px; }
            .auth-title { font-size: 2rem; }
        }
    </style>
</head>
<body>
    <div class="auth-shell">
        <section class="auth-stage">
            <div class="auth-brand">
                <div class="auth-brand-badge"><i class="bi bi-shield-check"></i></div>
                <span>Meeting Of Minutes</span>
            </div>

            <div>
                <h1>Create the Super Admin for your company.</h1>
                <p>Each company can have exactly one Super Admin. That account controls Admin and User creation, role changes and password recovery only inside that company.</p>

                <div class="auth-points">
                    <div class="auth-point">
                        <i class="bi bi-building"></i>
                        <div><strong>One per company</strong><br>Once a company Super Admin exists, all further Admin and User accounts are created from secured User Management.</div>
                    </div>
                    <div class="auth-point">
                        <i class="bi bi-people"></i>
                        <div><strong>Automatic user creation</strong><br>Staff records generate user accounts automatically with the correct company and department context.</div>
                    </div>
                    <div class="auth-point">
                        <i class="bi bi-bell"></i>
                        <div><strong>Approval workflow</strong><br>Admins receive profile update requests and password-change notifications inside the dashboard.</div>
                    </div>
                </div>
            </div>
        </section>

        <section class="auth-panel">
            <div class="auth-card">
                <div class="auth-eyebrow"><i class="bi bi-person-plus"></i> Company Super Admin</div>
                <div class="auth-title">Create company Super Admin</div>
                <div class="auth-subtitle">Choose the company that still needs a Super Admin. If that company already has one, signup will be blocked automatically.</div>

                <form method="post" asp-controller="Auth" asp-action="Register">
                    @Html.AntiForgeryToken()
                    <input asp-for="UserRole" type="hidden" value="SuperAdmin" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="CompanyName" class="auth-label">Company</label>
                            <select asp-for="CompanyName" asp-items="ViewBag.CompanyDropDown" class="form-select auth-control">`r`n                                <option value="">Select company</option>`r`n                            </select>
                            <span asp-validation-for="CompanyName" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="UserName" class="auth-label">User Name</label>
                            <input asp-for="UserName" class="form-control auth-control" placeholder="Enter user name" />
                            <span asp-validation-for="UserName" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="auth-label">Email</label>
                            <input asp-for="Email" class="form-control auth-control" placeholder="Enter email" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ContactNo" class="auth-label">Contact No</label>
                            <input asp-for="ContactNo" class="form-control auth-control" placeholder="Enter contact number" />
                            <span asp-validation-for="ContactNo" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="City" class="auth-label">City</label>
                            <input asp-for="City" class="form-control auth-control" placeholder="Enter city" />
                            <span asp-validation-for="City" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Password" class="auth-label">Password</label>
                            <div class="input-group auth-input-group">
                                <span class="input-group-text"><i class="bi bi-key"></i></span>
                                <input asp-for="Password" type="password" class="form-control auth-control" placeholder="Enter password" id="passwordField" />
                                <span class="input-group-text toggle-eye" id="togglePassword"><i class="bi bi-eye"></i></span>
                            </div>
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="auth-label">Confirm Password</label>
                            <div class="input-group auth-input-group">
                                <span class="input-group-text"><i class="bi bi-shield-lock"></i></span>
                                <input asp-for="ConfirmPassword" type="password" class="form-control auth-control" placeholder="Confirm password" id="confirmPasswordField" />
                                <span class="input-group-text toggle-eye" id="toggleConfirmPassword"><i class="bi bi-eye"></i></span>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="auth-rulebox mt-3 mb-4">
                        <div class="fw-semibold mb-2" style="color:#44516c;">Password must contain:</div>
                        <div class="rule" id="ruleLength"><i class="bi bi-dot"></i> Minimum 8 characters</div>
                        <div class="rule" id="ruleUpper"><i class="bi bi-dot"></i> At least 1 uppercase letter (A-Z)</div>
                        <div class="rule" id="ruleLower"><i class="bi bi-dot"></i> At least 1 lowercase letter (a-z)</div>
                        <div class="rule" id="ruleDigit"><i class="bi bi-dot"></i> At least 1 number (0-9)</div>
                        <div class="rule" id="ruleSpecial"><i class="bi bi-dot"></i> At least 1 special character (!#@@$...)</div>
                    </div>

                    <button type="submit" class="btn auth-submit w-100 text-white">Create Super Admin</button>
                </form>

                <div class="text-center mt-3">
                    <a asp-controller="Auth" asp-action="Login" class="auth-link">Back to Login</a>
                </div>
            </div>
        </section>
    </div>

    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            const passwordField = document.getElementById('passwordField');
            const confirmPasswordField = document.getElementById('confirmPasswordField');
            const togglePassword = document.getElementById('togglePassword');
            const toggleConfirmPassword = document.getElementById('toggleConfirmPassword');

            function toggleInput(input, iconWrap) {
                const icon = iconWrap.querySelector('i');
                if (input.type === 'password') {
                    input.type = 'text';
                    icon.className = 'bi bi-eye-slash';
                } else {
                    input.type = 'password';
                    icon.className = 'bi bi-eye';
                }
            }

            if (togglePassword) {
                togglePassword.addEventListener('click', function () { toggleInput(passwordField, togglePassword); });
            }

            if (toggleConfirmPassword) {
                toggleConfirmPassword.addEventListener('click', function () { toggleInput(confirmPasswordField, toggleConfirmPassword); });
            }

            function setRule(id, ok) {
                const el = document.getElementById(id);
                if (!el) return;
                if (ok) el.classList.add('ok'); else el.classList.remove('ok');
            }

            function validatePasswordUI() {
                const value = passwordField ? passwordField.value : '';
                setRule('ruleLength', value.length >= 8);
                setRule('ruleUpper', /[A-Z]/.test(value));
                setRule('ruleLower', /[a-z]/.test(value));
                setRule('ruleDigit', /\d/.test(value));
                setRule('ruleSpecial', /[^A-Za-z0-9]/.test(value));
            }

            if (passwordField) {
                passwordField.addEventListener('input', validatePasswordUI);
                validatePasswordUI();
            }
        })();
    </script>
</body>
</html>

