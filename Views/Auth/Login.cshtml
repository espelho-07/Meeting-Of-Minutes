@model Meeting_Of_Minutes.Models.UserModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Login | Meeting Of Minutes</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        :root {
            --mom-bg: #eef2f8;
            --mom-surface: rgba(255,255,255,0.94);
            --mom-border: #dde4f0;
            --mom-text: #172033;
            --mom-muted: #6f7d95;
            --mom-accent: #5b5ce6;
            --mom-accent-soft: #eef1ff;
            --mom-shadow: 0 24px 60px rgba(19, 28, 53, 0.12);
        }

        * { box-sizing: border-box; }

        body {
            min-height: 100vh;
            margin: 0;
            background:
                radial-gradient(circle at top left, rgba(91,92,230,0.16), transparent 26%),
                radial-gradient(circle at bottom right, rgba(117,126,255,0.12), transparent 24%),
                linear-gradient(180deg, #f7f9fc 0%, var(--mom-bg) 100%);
            font-family: "Nunito", sans-serif;
            color: var(--mom-text);
        }

        .auth-shell {
            min-height: 100vh;
            display: grid;
            grid-template-columns: 1.05fr 0.95fr;
            padding: 28px;
            gap: 24px;
        }

        .auth-stage,
        .auth-panel {
            border-radius: 32px;
            overflow: hidden;
            border: 1px solid rgba(221,228,240,0.9);
            box-shadow: var(--mom-shadow);
        }

        .auth-stage {
            background: linear-gradient(160deg, #1f255f 0%, #2d367d 45%, #5862e7 100%);
            color: #fff;
            padding: 42px;
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .auth-brand {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            font-weight: 800;
            letter-spacing: 0.02em;
        }

        .auth-brand-badge {
            width: 46px;
            height: 46px;
            border-radius: 16px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: rgba(255,255,255,0.14);
            border: 1px solid rgba(255,255,255,0.18);
        }

        .auth-stage h1 {
            font-size: clamp(2.5rem, 4vw, 4.2rem);
            line-height: 0.98;
            font-weight: 900;
            margin: 0 0 16px;
            max-width: 540px;
        }

        .auth-stage p {
            max-width: 520px;
            color: rgba(255,255,255,0.76);
            font-size: 1.02rem;
            margin-bottom: 0;
        }

        .auth-stage-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 14px;
            margin-top: 28px;
        }

        .auth-stage-card {
            padding: 18px;
            border-radius: 22px;
            background: rgba(255,255,255,0.10);
            border: 1px solid rgba(255,255,255,0.14);
            backdrop-filter: blur(10px);
        }

        .auth-stage-card small {
            color: rgba(255,255,255,0.68);
            text-transform: uppercase;
            letter-spacing: 0.08em;
            font-weight: 800;
        }

        .auth-stage-card div {
            margin-top: 8px;
            font-weight: 800;
            font-size: 1rem;
        }

        .auth-panel {
            background: var(--mom-surface);
            backdrop-filter: blur(18px);
            padding: 28px;
            display: flex;
            align-items: center;
        }

        .auth-card {
            width: 100%;
            max-width: 520px;
            margin: 0 auto;
        }

        .auth-eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            border-radius: 999px;
            padding: 8px 12px;
            background: var(--mom-accent-soft);
            color: var(--mom-accent);
            font-weight: 800;
            margin-bottom: 18px;
        }

        .auth-title {
            font-size: 2.4rem;
            line-height: 1;
            font-weight: 900;
            margin-bottom: 10px;
        }

        .auth-subtitle {
            color: var(--mom-muted);
            margin-bottom: 26px;
        }

        .auth-label {
            font-size: 0.84rem;
            font-weight: 800;
            color: #44516c;
            margin-bottom: 6px;
        }

        .auth-input-group {
            display: flex;
            align-items: center;
            border: 1px solid var(--mom-border);
            border-radius: 16px;
            background: #fff;
            overflow: hidden;
            min-height: 54px;
            box-shadow: inset 0 1px 0 rgba(255,255,255,0.8);
        }

        .auth-input-group span {
            width: 52px;
            text-align: center;
            color: #93a0b8;
            flex-shrink: 0;
        }

        .auth-input-group input,
        .auth-input-group select {
            border: 0 !important;
            background: transparent !important;
            box-shadow: none !important;
            min-height: 52px;
        }

        .auth-toggle {
            width: 50px !important;
            cursor: pointer;
            border-left: 1px solid var(--mom-border);
        }

        .auth-submit {
            background: linear-gradient(90deg, #4f5bea 0%, #6672ff 100%);
            border: 0;
            border-radius: 16px;
            min-height: 54px;
            font-weight: 800;
            letter-spacing: 0.01em;
            box-shadow: 0 18px 30px rgba(91, 92, 230, 0.22);
        }

        .auth-footer-link,
        .auth-footer-link:hover {
            color: var(--mom-accent);
            text-decoration: none;
            font-weight: 800;
        }

        @@media (max-width: 1100px) {
            .auth-shell { grid-template-columns: 1fr; }
            .auth-stage { min-height: 420px; }
        }

        @@media (max-width: 767px) {
            .auth-shell { padding: 16px; }
            .auth-stage, .auth-panel { border-radius: 24px; }
            .auth-stage { padding: 24px; }
            .auth-panel { padding: 18px; }
            .auth-stage-grid { grid-template-columns: 1fr; }
            .auth-title { font-size: 2rem; }
        }
    </style>
</head>
<body>
    <div class="auth-shell">
        <section class="auth-stage">
            <div>
                <div class="auth-brand">
                    <div class="auth-brand-badge"><i class="bi bi-calendar-check"></i></div>
                    <span>Meeting Of Minutes</span>
                </div>
            </div>

            <div>
                <h1>Operations start with the right login context.</h1>
                <p>Enter the user email first. We will pull the correct role, company and department context so the workspace opens with the right scope.</p>

                <div class="auth-stage-grid">
                    <div class="auth-stage-card">
                        <small>Scoped Access</small>
                        <div>Admin and user workspaces stay separated.</div>
                    </div>
                    <div class="auth-stage-card">
                        <small>Company Scoped</small>
                        <div>Super Admin access is locked to a single company only.</div>
                    </div>
                    <div class="auth-stage-card">
                        <small>Ready Flow</small>
                        <div>Staff-created users can sign in without manual setup.</div>
                    </div>
                </div>
            </div>
        </section>

        <section class="auth-panel">
            <div class="auth-card">
                <div class="auth-eyebrow"><i class="bi bi-box-arrow-in-right"></i> Secure Sign In</div>
                <div class="auth-title">Welcome back</div>
                <div class="auth-subtitle">Use your email and password to continue into your meeting workspace.</div>

                <form method="post" asp-controller="Auth" asp-action="Login">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger text-start mb-2"></div>

                    <label class="auth-label" asp-for="Email">Email Address</label>
                    <div class="auth-input-group mb-3">
                        <span><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" type="email" class="form-control" placeholder="Enter email address" id="loginEmail">
                    </div>
                    <span asp-validation-for="Email" class="text-danger d-block text-start mb-2"></span>

                    <label class="auth-label" asp-for="UserRole">Login As</label>
                    <div class="auth-input-group mb-3">
                        <span><i class="bi bi-shield-lock"></i></span>
                        <select asp-for="UserRole" class="form-select" id="loginRole">
                            <option value="">Select role</option>                            <option value="SuperAdmin">Super Admin</option>
                            <option value="Admin">Admin</option>
                            <option value="User">User</option>
                        </select>
                    </div>
                    <span asp-validation-for="UserRole" class="text-danger d-block text-start mb-2"></span>

                    <label class="auth-label" asp-for="CompanyName">Company</label>
                    <div class="auth-input-group mb-3">
                        <span><i class="bi bi-buildings"></i></span>
                        <select asp-for="CompanyName" asp-items="ViewBag.CompanyDropDown" class="form-select" id="loginCompany">
                            <option value="">Select company</option>
                        </select>
                    </div>
                    <span asp-validation-for="CompanyName" class="text-danger d-block text-start mb-2"></span>

                    <div id="loginDepartmentWrap">
                        <label class="auth-label" asp-for="DepartmentID">Department</label>
                        <div class="auth-input-group mb-3">
                            <span><i class="bi bi-building"></i></span>
                            <select asp-for="DepartmentID" class="form-select" id="loginDepartment">
                                <option value="">Select department</option>
                            </select>
                        </div>
                        <span asp-validation-for="DepartmentID" class="text-danger d-block text-start mb-2"></span>
                    </div>

                    <label class="auth-label" asp-for="Password">Password</label>
                    <div class="auth-input-group mb-3">
                        <span><i class="bi bi-key"></i></span>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Enter password" id="loginPassword">
                        <span class="auth-toggle" onclick="toggleLoginPassword()"><i class="bi bi-eye"></i></span>
                    </div>
                    <span asp-validation-for="Password" class="text-danger d-block text-start mb-4"></span>

                    <button type="submit" class="auth-submit btn w-100 text-white">
                        <i class="bi bi-box-arrow-in-right me-1"></i>Sign In
                    </button>
                </form>

                <div class="text-center mt-4 pt-3 border-top">                    <span>Need to set up a company? <a class="auth-footer-link" asp-controller="Auth" asp-action="Register">Create company Super Admin</a></span>
                </div>
            </div>
        </section>
    </div>

    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleLoginPassword() {
            const input = document.getElementById('loginPassword');
            if (!input) return;
            input.type = input.type === 'password' ? 'text' : 'password';
        }

        function toggleLoginDepartment() {
            const role = document.getElementById('loginRole');
            const company = document.getElementById('loginCompany');
            const wrap = document.getElementById('loginDepartmentWrap');
            if (!role || !wrap || !company) return;
            wrap.style.display = role.value === 'User' ? '' : 'none';
        }

        async function loadDepartments(companyName, selectedDepartmentId) {
            const department = document.getElementById('loginDepartment');
            if (!department) return;
            department.innerHTML = '<option value="">Select department</option>';
            if (!companyName) return;
            const response = await fetch(`/Auth/GetDepartmentsByCompany?companyName=${encodeURIComponent(companyName)}`);
            const data = await response.json();
            data.forEach(item => {
                const option = document.createElement('option');
                option.value = item.value;
                option.text = item.text;
                if (selectedDepartmentId && selectedDepartmentId.toString() === item.value.toString()) {
                    option.selected = true;
                }
                department.appendChild(option);
            });
        }

        async function autofillLoginContext() {
            const email = document.getElementById('loginEmail');
            const role = document.getElementById('loginRole');
            const company = document.getElementById('loginCompany');
            const department = document.getElementById('loginDepartment');
            if (!email || !role || !company || !department || !email.value) return;

            const response = await fetch(`/Auth/GetUserContextByEmail?email=${encodeURIComponent(email.value)}`);
            const data = await response.json();
            if (!data.found) return;

            role.value = data.userRole || '';
            company.value = data.companyName || '';
            toggleLoginDepartment();
            await loadDepartments(company.value, data.departmentId);
        }

        document.addEventListener('DOMContentLoaded', function () {
            const role = document.getElementById('loginRole');
            const email = document.getElementById('loginEmail');
            const company = document.getElementById('loginCompany');
            if (role) {
                role.addEventListener('change', toggleLoginDepartment);
                toggleLoginDepartment();
            }
            if (email) {
                email.addEventListener('change', autofillLoginContext);
                email.addEventListener('blur', autofillLoginContext);
            }
            if (company) {
                company.addEventListener('change', function () {
                    loadDepartments(company.value, null);
                });
            }
        });
    </script>
</body>
</html>



