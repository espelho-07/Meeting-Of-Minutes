@using System.Text.Json
@{
    ViewData["Title"] = "Dashboard - Meeting Of Minutes";
    var recentMeetings = ViewBag.RecentMeetings as List<MeetingsModel> ?? new List<MeetingsModel>();
    var typeLabels = ViewBag.TypeLabels as List<string> ?? new List<string>();
    var typeValues = ViewBag.TypeValues as List<int> ?? new List<int>();
    var departmentLabels = ViewBag.DepartmentLabels as List<string> ?? new List<string>();
    var departmentValues = ViewBag.DepartmentValues as List<int> ?? new List<int>();
    var adminNotifications = ViewBag.AdminNotifications as List<AdminNotificationModel> ?? new List<AdminNotificationModel>();
    var recentActivityLogs = ViewBag.RecentActivityLogs as List<AuditLogModel> ?? new List<AuditLogModel>();
    var failedLoginLogs = ViewBag.FailedLoginLogs as List<AuditLogModel> ?? new List<AuditLogModel>();
    var pendingProfileRequests = ViewBag.PendingProfileRequests as List<ProfileUpdateRequestModel> ?? new List<ProfileUpdateRequestModel>();
    var pendingTransferRequests = ViewBag.PendingTransferRequests as List<StaffTransferRequestModel> ?? new List<StaffTransferRequestModel>();
    var actionCenterSummary = ViewBag.ActionCenterSummary as ActionCenterSummaryModel ?? new ActionCenterSummaryModel();
    var nextMeeting = ViewBag.NextMeeting as MeetingsModel;
    bool isSuperAdminDashboard = ViewBag.IsSuperAdminDashboard is bool superAdminFlag && superAdminFlag;
    int platformCompanyCount = ViewBag.PlatformCompanyCount is int companyCount ? companyCount : 1;
    bool isAdminUser = (Context.Session.GetString("UserRole") ?? string.Empty).Equals("Admin", StringComparison.OrdinalIgnoreCase) || (Context.Session.GetString("UserRole") ?? string.Empty).Equals("SuperAdmin", StringComparison.OrdinalIgnoreCase);
}

@await Html.PartialAsync("_AlertMessages")

<div class="pagetitle mb-4">
    <nav>
        <ol class="breadcrumb flex-nowrap">
            <li class="breadcrumb-item"><a asp-controller="DashBoard" asp-action="DashBoard"><i class="bi bi-house-door"></i></a></li>
            <li class="breadcrumb-item active">Dashboard</li>
        </ol>
    </nav>
</div>

<section class="mom-dash-shell mom-dashboard-page">
    <div class="mom-hero-band">
        <div class="mom-hero-copy">
            <div class="mom-hero-kicker"><i class="bi bi-stars"></i>@(isSuperAdminDashboard ? "Super Admin Command Center" : isAdminUser ? "Admin Command Center" : "My Meeting Workspace")</div>
            <div class="mom-hero-title">Welcome back, @Context.Session.GetString("UserName")</div>
            <div class="mom-hero-subtitle">
                @(isSuperAdminDashboard
                    ? "You are looking at platform-wide meeting volume, account readiness and approval pressure across every company in the system."
                    : isAdminUser
                    ? "Monitor company-wide meeting flow, resolve profile actions quickly and keep scheduling, attendance and staff coordination in one operational surface."
                    : "See only the meetings assigned to you, track approval progress and stay ready for your next meeting from one clean personal workspace.")
            </div>
            <div class="mom-hero-tags">
                <span class="mom-hero-tag"><i class="bi bi-buildings"></i>@(isSuperAdminDashboard ? $"{platformCompanyCount} companies in scope" : (string.IsNullOrWhiteSpace(Context.Session.GetString("CompanyName")) ? "No Company" : Context.Session.GetString("CompanyName")))</span>
                <span class="mom-hero-tag"><i class="bi bi-grid-1x2"></i>@(isSuperAdminDashboard ? "Platform governance workspace" : isAdminUser ? "Full access workspace" : "Assigned meeting access")</span>
                <span class="mom-hero-tag"><i class="bi bi-arrow-clockwise"></i>@(isSuperAdminDashboard ? "Global operational view" : isAdminUser ? "Live operational view" : "My next actions")</span>
            </div>
        </div>
        <div class="mom-hero-side">
            <div class="mom-hero-metric">
                <div class="mom-hero-metric-label">@(isSuperAdminDashboard ? "Meetings Across Platform" : isAdminUser ? "Meetings in System" : "Meetings Assigned")</div>
                <div class="mom-hero-metric-value">@ViewBag.TotalMeetings</div>
                <div class="mom-hero-metric-sub">@(isSuperAdminDashboard ? "All visible scheduled records across every company scope." : isAdminUser ? "Visible scheduled records across your current access scope." : "Meetings currently available to your account access.")</div>
            </div>
            <div class="mom-hero-metric">
                <div class="mom-hero-metric-label">@(isSuperAdminDashboard ? "Open Platform Actions" : isAdminUser ? "Current Activity" : "Pending Requests")</div>
                <div class="mom-hero-metric-value">@(isAdminUser ? ViewBag.ActiveMeetings : (pendingProfileRequests.Count + pendingTransferRequests.Count))</div>
                <div class="mom-hero-metric-sub">@(isSuperAdminDashboard ? "Upcoming meetings and pending approvals still waiting on platform attention." : isAdminUser ? "Upcoming or in-flow meetings that still need operational attention." : "Profile and transfer approvals still waiting on admin action.")</div>
            </div>
            <div class="mom-hero-metric">
                <div class="mom-hero-metric-label">@(isSuperAdminDashboard ? "Platform Attendance" : isAdminUser ? "Attendance Logged" : "Next Meeting")</div>
                <div class="mom-hero-metric-value">@(isAdminUser ? ViewBag.TotalAttendees : (nextMeeting?.MeetingDate?.ToString("dd MMM") ?? "None"))</div>
                <div class="mom-hero-metric-sub">@(isSuperAdminDashboard ? "Attendance entries recorded across all currently visible meetings." : isAdminUser ? "Attendance entries recorded inside the current visible meeting set." : (nextMeeting == null ? "No upcoming meeting is currently assigned." : $"{nextMeeting.MeetingDescription}"))</div>
            </div>
        </div>
    </div>

    <div class="mom-page-header">
        <div class="mom-dash-title">
            <h1>Overview</h1>
            <p>@(isSuperAdminDashboard ? "Platform-wide meeting analytics, access health and cross-company operational posture." : isAdminUser ? "Live meeting analytics, approval activity and company scheduling posture." : "Your own meeting timeline, request status and upcoming work queue.")</p>
        </div>
        <div class="mom-toolbar">
            <button class="btn btn-light px-4" onclick="location.reload();"><i class="bi bi-arrow-clockwise me-2"></i>Refresh Data</button>
            @if (isAdminUser)
            {
                <button class="btn btn-primary px-4"><i class="bi bi-download me-2"></i>Export Report</button>
            }
        </div>
    </div>

    <div class="mom-overview-grid">
        @await Html.PartialAsync("_MetricCard", new StatCardViewModel { Tone = "purple", IconClass = "bi bi-calendar-event", Tag = "All Time", Value = Convert.ToString(ViewBag.TotalMeetings) ?? "0", Label = "Total Scheduled Meetings" })
        @await Html.PartialAsync("_MetricCard", new StatCardViewModel { Tone = "blue", IconClass = "bi bi-check2-circle", Tag = "Active", Value = Convert.ToString(isAdminUser ? ViewBag.ActiveMeetings : ViewBag.CompletedMeetings) ?? "0", Label = isAdminUser ? "Completed / Upcoming" : "Completed Meetings" })
        @await Html.PartialAsync("_MetricCard", new StatCardViewModel { Tone = "amber", IconClass = "bi bi-x-octagon", Tag = isAdminUser ? "Recorded" : "Requests", Value = Convert.ToString(isAdminUser ? ViewBag.CancelledMeetings : pendingProfileRequests.Count) ?? "0", Label = isAdminUser ? "Cancelled Meetings" : "Profile Requests Pending" })
        @await Html.PartialAsync("_MetricCard", new StatCardViewModel { Tone = "green", IconClass = "bi bi-people", Tag = isAdminUser ? "Records" : "Transfer", Value = Convert.ToString(isAdminUser ? ViewBag.TotalAttendees : pendingTransferRequests.Count) ?? "0", Label = isAdminUser ? "Total Attendees Logged" : "Transfer Requests Pending" })
    </div>

    <div class="mom-queue-snapshot">
        <div class="mom-logs-head mb-3">
            <h5>Queue Snapshot</h5>
            <a asp-controller="ActionCenter" asp-action="Index" class="mom-section-link"><i class="bi bi-arrow-right-circle"></i>Open Action Center</a>
        </div>
        <div class="mom-queue-snapshot-grid">
            <div class="mom-queue-snapshot-metrics">
                <div class="mom-queue-snapshot-card">
                    <div class="mom-hero-metric-label">Open Queue</div>
                    <div class="mom-queue-snapshot-value">@actionCenterSummary.OpenActionCount</div>
                    <div class="mom-activity-meta">Current action items visible in this workspace.</div>
                </div>
                <div class="mom-queue-snapshot-card">
                    <div class="mom-hero-metric-label">SLA Watch</div>
                    <div class="d-flex gap-2 flex-wrap">
                        <span class="mom-soft-tag">@actionCenterSummary.Overdue24Count overdue 24h+</span>
                        <span class="mom-soft-tag @(actionCenterSummary.Overdue72Count > 0 ? "text-danger border border-danger-subtle bg-danger-subtle" : string.Empty)">@actionCenterSummary.Overdue72Count overdue 72h+</span>
                    </div>
                </div>
            </div>
            <div class="mom-queue-preview-list">
                @if (actionCenterSummary.PreviewItems.Count == 0)
                {
                    @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel
                    {
                        IconClass = "bi bi-lightning-charge",
                        Title = "Queue is clear",
                        Description = "There are no live action items visible in this workspace right now.",
                        Compact = true
                    })
                }
                @foreach (var item in actionCenterSummary.PreviewItems)
                {
                    string queueTargetUrl = string.IsNullOrWhiteSpace(item.TargetUrl) ? Url.Action("Index", "ActionCenter") ?? "#" : item.TargetUrl;
                    <a href="@queueTargetUrl" class="mom-queue-preview-item">
                        <div class="mom-activity-top">
                            <div class="mom-activity-title">@item.Title</div>
                            <span class="mom-soft-tag @(item.IsCritical ? "text-danger border border-danger-subtle bg-danger-subtle" : item.IsStale24Hours ? "text-warning border border-warning-subtle bg-warning-subtle" : string.Empty)">@item.PriorityLabel</span>
                        </div>
                        <div class="mom-notify-text">@item.Description</div>
                        <div class="mom-activity-meta">@item.Meta</div>
                    </a>
                }
            </div>
        </div>
    </div>

    <div class="mom-inbox-grid">
        <div class="mom-inbox-card">
            <div class="mom-inbox-head">
                <div>
                    <h5>@(isAdminUser ? "Action Inbox" : "My Action Inbox")</h5>
                    <p>@(isAdminUser ? "High-priority approvals and requests that still need a decision." : "Pending items and approvals connected to your account.")</p>
                </div>
                <span class="mom-soft-tag">@ViewBag.ActionInboxCount items</span>
            </div>
            <div class="mom-inbox-list">
                @if (isAdminUser)
                {
                    @if (pendingProfileRequests.Count == 0 && pendingTransferRequests.Count == 0)
                    {
                        <div class="mom-dash-empty">No pending approvals right now.</div>
                    }
                    @foreach (var request in pendingProfileRequests.Take(3))
                    {
                        <div class="mom-inbox-item">
                            <div class="mom-inbox-item-top">
                                <div class="mom-inbox-item-title">Profile update for @request.CurrentUserName</div>
                                <span class="mom-soft-tag">Profile</span>
                            </div>
                            <div class="mom-inbox-item-text">@request.RequestedEmail • @(string.IsNullOrWhiteSpace(request.DepartmentName) ? "No department" : request.DepartmentName)</div>
                            <div class="mom-inbox-item-meta">@request.Created.ToString("dd MMM yyyy hh:mm tt")</div>
                        </div>
                    }
                    @foreach (var request in pendingTransferRequests.Take(3))
                    {
                        <div class="mom-inbox-item">
                            <div class="mom-inbox-item-top">
                                <div class="mom-inbox-item-title">@request.StaffName transfer request</div>
                                <span class="mom-soft-tag">Transfer</span>
                            </div>
                            <div class="mom-inbox-item-text">@request.SourceCompanyName to @request.TargetDepartmentName</div>
                            <div class="mom-inbox-item-meta">@request.Created.ToString("dd MMM yyyy hh:mm tt")</div>
                        </div>
                    }
                    <div class="d-flex gap-2 flex-wrap pt-2">
                        <a asp-controller="Profile" asp-action="ProfileUpdateRequestList" class="mom-section-link"><i class="bi bi-arrow-right-circle"></i>Review profile requests</a>
                        <a asp-controller="Staff" asp-action="StaffTransferRequestList" class="mom-section-link"><i class="bi bi-arrow-right-circle"></i>Review transfer requests</a>
                    </div>
                }
                else
                {
                    @if (pendingProfileRequests.Count == 0 && pendingTransferRequests.Count == 0)
                    {
                        <div class="mom-dash-empty">No pending requests right now. Your workspace looks clear.</div>
                    }
                    @foreach (var request in pendingProfileRequests.Take(3))
                    {
                        <div class="mom-inbox-item">
                            <div class="mom-inbox-item-top">
                                <div class="mom-inbox-item-title">Profile update request</div>
                                <span class="mom-soft-tag">@request.RequestStatus</span>
                            </div>
                            <div class="mom-inbox-item-text">Requested email: @request.RequestedEmail</div>
                            <div class="mom-inbox-item-meta">@request.Created.ToString("dd MMM yyyy hh:mm tt")</div>
                        </div>
                    }
                    @foreach (var request in pendingTransferRequests.Take(3))
                    {
                        <div class="mom-inbox-item">
                            <div class="mom-inbox-item-top">
                                <div class="mom-inbox-item-title">Transfer request to @request.TargetCompanyName</div>
                                <span class="mom-soft-tag">@request.RequestStatus</span>
                            </div>
                            <div class="mom-inbox-item-text">Target department: @request.TargetDepartmentName</div>
                            <div class="mom-inbox-item-meta">@request.Created.ToString("dd MMM yyyy hh:mm tt")</div>
                        </div>
                    }
                    <div class="pt-2">
                        <a asp-controller="Profile" asp-action="Profile" class="mom-section-link"><i class="bi bi-arrow-right-circle"></i>Open my profile workspace</a>
                    </div>
                }
            </div>
        </div>

        <div class="mom-inbox-card">
            <div class="mom-inbox-head">
                <div>
                    <h5>@(isAdminUser ? "Access & Risk Signals" : "My Workspace Signals")</h5>
                    <p>@(isAdminUser ? "Surface suspicious sign-ins and sensitive events before they become problems." : "Quick context on what needs your attention next.")</p>
                </div>
                <a asp-controller="Activity" asp-action="ActivityLog" class="mom-section-link"><i class="bi bi-activity"></i>Open activity center</a>
            </div>
            @if (isAdminUser)
            {
                <div class="mom-risk-list">
                    @if (failedLoginLogs.Count == 0)
                    {
                        <div class="mom-dash-empty">No failed login attempts found in recent activity.</div>
                    }
                    @foreach (var log in failedLoginLogs)
                    {
                        <div class="mom-risk-item">
                            <div class="mom-risk-icon"><i class="bi bi-shield-exclamation"></i></div>
                            <div>
                                <div class="mom-inbox-item-title">@log.Title</div>
                                <div class="mom-inbox-item-text">@log.Description</div>
                                <div class="mom-inbox-item-meta">@log.Created.ToString("dd MMM yyyy hh:mm tt")</div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="mom-notify-list">
                    <div class="mom-notify-item">
                        <div class="mom-notify-icon"><i class="bi bi-calendar2-week"></i></div>
                        <div>
                            <div class="mom-notify-title">Next meeting</div>
                            <div class="mom-notify-text">@(nextMeeting == null ? "No upcoming meeting assigned right now." : nextMeeting.MeetingDescription)</div>
                            <div class="mom-notify-time">@(nextMeeting?.MeetingDate?.ToString("dd MMM yyyy hh:mm tt") ?? "Waiting for schedule")</div>
                        </div>
                    </div>
                    <div class="mom-notify-item">
                        <div class="mom-notify-icon"><i class="bi bi-person-gear"></i></div>
                        <div>
                            <div class="mom-notify-title">Account readiness</div>
                            <div class="mom-notify-text">@((pendingProfileRequests.Count + pendingTransferRequests.Count) == 0 ? "No pending account requests. Your profile workspace is clear." : "You still have pending profile or transfer requests awaiting action.")</div>
                            <div class="mom-notify-time">Review them from your profile workspace.</div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    @if (isAdminUser)
    {
        <div class="row g-4">
            <div class="col-xl-6">
                <div class="mom-notify-card h-100">
                    <div class="mom-logs-head mb-3">
                        <h5>Admin Notifications</h5>
                        <div class="text-muted small">Profile update requests, password changes and user activity.</div>
                    </div>

                    @if (adminNotifications.Count == 0)
                    {
                        <div class="mom-dash-empty">No recent notifications found.</div>
                    }
                    else
                    {
                        <div class="mom-notify-list">
                            @foreach (var notification in adminNotifications)
                            {
                                <div class="mom-notify-item">
                                    <div class="mom-notify-icon">
                                        @if (notification.NotificationType == "PasswordChanged")
                                        {
                                            <i class="bi bi-key"></i>
                                        }
                                        else if (notification.NotificationType == "StaffTransferRequest")
                                        {
                                            <i class="bi bi-arrow-left-right"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-person-lines-fill"></i>
                                        }
                                    </div>
                                    <div>
                                        <div class="mom-notify-title">@notification.Title</div>
                                        <div class="mom-notify-text">@notification.Message</div>
                                        <div class="mom-notify-meta">
                                            <span class="mom-soft-tag">@(notification.NotificationType == "PasswordChanged" ? "Password" : notification.NotificationType == "StaffTransferRequest" ? "Transfer Request" : "Profile Request")</span>
                                            <div class="mom-notify-time">@notification.Created.ToString("dd MMM yyyy hh:mm tt")</div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
            <div class="col-xl-6">
                <div class="mom-notify-card h-100">
                    <div class="mom-logs-head mb-3">
                        <h5>Activity Stream</h5>
                        <div class="text-muted small">Real operational actions happening across your company workspace.</div>
                    </div>
                    @if (recentActivityLogs.Count == 0)
                    {
                        <div class="mom-dash-empty">No activity recorded yet.</div>
                    }
                    else
                    {
                        <div class="mom-activity-list">
                            @foreach (var log in recentActivityLogs)
                            {
                                <div class="mom-activity-item">
                                    <div class="mom-activity-top">
                                        <div class="mom-activity-title">@log.Title</div>
                                        <span class="mom-soft-tag">@log.ActionType</span>
                                    </div>
                                    <div class="mom-notify-text">@log.Description</div>
                                    <div class="mom-activity-meta">@log.UserName | @log.Created.ToString("dd MMM yyyy hh:mm tt")</div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    @if (isAdminUser)
    {
        <div class="row g-4">
            <div class="col-xl-5">
                <div class="mom-chart-card">
                    <div class="mom-chart-head">
                        <h5>Meeting Distribution</h5>
                        <div class="mom-chart-action"><i class="bi bi-arrow-clockwise"></i></div>
                    </div>
                    <div class="mom-chart-body">
                        <div id="meetingDistributionChart"></div>
                    </div>
                </div>
            </div>
            <div class="col-xl-7">
                <div class="mom-chart-card">
                    <div class="mom-chart-head">
                        <h5>Department Involvement</h5>
                        <div class="mom-chart-action"><i class="bi bi-arrow-clockwise"></i></div>
                    </div>
                    <div class="mom-chart-body">
                        <div id="departmentInvolvementChart"></div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-xl-7">
                <div class="mom-chart-card">
                    <div class="mom-chart-head">
                        <h5>My Upcoming Queue</h5>
                        <div class="mom-chart-action"><i class="bi bi-calendar-check"></i></div>
                    </div>
                    <div class="mom-chart-body">
                        @if (recentMeetings.Count == 0)
                        {
                            <div class="mom-dash-empty">No meetings are currently assigned to you.</div>
                        }
                        else
                        {
                            foreach (var meeting in recentMeetings.Where(x => !x.IsCancelled).OrderBy(x => x.MeetingDate).Take(4))
                            {
                                <div class="mom-log-row">
                                    <div>
                                        <div class="mom-log-title">@meeting.MeetingDescription</div>
                                        <div class="mom-log-sub">@meeting.MeetingTypeName</div>
                                    </div>
                                    <div>
                                        <div class="mom-log-title">@meeting.DepartmentName</div>
                                        <div class="mom-log-sub">Department</div>
                                    </div>
                                    <div>
                                        <div class="mom-log-title">@meeting.MeetingDate?.ToString("dd MMM yyyy")</div>
                                        <div class="mom-log-sub">@meeting.MeetingDate?.ToString("hh:mm tt")</div>
                                    </div>
                                    <div>
                                        @if (meeting.MeetingDate > DateTime.Now)
                                        {
                                            <span class="badge bg-primary">Upcoming</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Completed</span>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
            <div class="col-xl-5">
                <div class="mom-notify-card h-100">
                    <div class="mom-logs-head mb-3">
                        <h5>My Activity</h5>
                        <div class="text-muted small">Recent account and request actions connected to your workspace.</div>
                    </div>

                    <div class="mom-notify-list">
                        @if (recentActivityLogs.Count == 0)
                        {
                            <div class="mom-dash-empty">No recent activity right now.</div>
                        }
                        @foreach (var log in recentActivityLogs)
                        {
                            <div class="mom-notify-item">
                                <div class="mom-notify-icon"><i class="bi bi-activity"></i></div>
                                <div>
                                    <div class="mom-notify-title">@log.Title</div>
                                    <div class="mom-notify-text">@log.Description</div>
                                    <div class="mom-notify-time">@log.Created.ToString("dd MMM yyyy hh:mm tt")</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="mom-logs-card">
        <div class="mom-logs-head">
            <h5>@(isAdminUser ? "Recent Meeting Logs" : "My Meeting Logs")</h5>
            <div class="mom-search-input" style="max-width: 320px;">
                <span><i class="bi bi-search"></i></span>
                <input type="text" id="meetingSearchInput" class="form-control" placeholder="Search meeting title..." onkeyup="filterMeetingLogs()">
            </div>
        </div>

        <div id="meetingLogsWrap">
            @if (recentMeetings.Count == 0)
            {
                <div class="mom-dash-empty">No recent meetings found.</div>
            }
            else
            {
                @foreach (var meeting in recentMeetings)
                {
                    <div class="mom-log-row">
                        <div>
                            <div class="mom-log-title">@meeting.MeetingDescription</div>
                            <div class="mom-log-sub">@meeting.MeetingTypeName</div>
                        </div>
                        <div>
                            <div class="mom-log-title">@meeting.DepartmentName</div>
                            <div class="mom-log-sub">Department</div>
                        </div>
                        <div>
                            <div class="mom-log-title">@meeting.MeetingDate?.ToString("dd MMM yyyy")</div>
                            <div class="mom-log-sub">@meeting.MeetingDate?.ToString("hh:mm tt")</div>
                        </div>
                        <div>
                            @if (meeting.IsCancelled)
                            {
                                <span class="badge bg-danger">Cancelled</span>
                            }
                            else if (meeting.MeetingDate > DateTime.Now)
                            {
                                <span class="badge bg-primary">Upcoming</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Completed</span>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
<script>
    const meetingTypeLabels = @Html.Raw(JsonSerializer.Serialize(typeLabels));
    const meetingTypeValues = @Html.Raw(JsonSerializer.Serialize(typeValues));
    const departmentLabels = @Html.Raw(JsonSerializer.Serialize(departmentLabels));
    const departmentValues = @Html.Raw(JsonSerializer.Serialize(departmentValues));

    if (@(isAdminUser.ToString().ToLower()) && document.getElementById("meetingDistributionChart")) {
        const distributionChart = new ApexCharts(document.querySelector("#meetingDistributionChart"), {
            chart: { type: "donut", height: 320, toolbar: { show: false } },
            series: meetingTypeValues.length ? meetingTypeValues : [1],
            labels: meetingTypeLabels.length ? meetingTypeLabels : ["No Data"],
            colors: ["#6c63ff", "#24c1a7", "#ffb000", "#3f8cff", "#ff6b6b", "#8b5cf6"],
            legend: { position: "bottom", fontSize: "13px" },
            dataLabels: { enabled: false },
            stroke: { width: 0 },
            plotOptions: {
                pie: {
                    donut: {
                        size: "68%"
                    }
                }
            }
        });
        distributionChart.render();
    }

    if (@(isAdminUser.ToString().ToLower()) && document.getElementById("departmentInvolvementChart")) {
        const departmentChart = new ApexCharts(document.querySelector("#departmentInvolvementChart"), {
            chart: { type: "bar", height: 320, toolbar: { show: false } },
            series: [{ name: "Meetings", data: departmentValues.length ? departmentValues : [0] }],
            xaxis: { categories: departmentLabels.length ? departmentLabels : ["No Data"] },
            colors: ["#6c63ff"],
            plotOptions: {
                bar: {
                    borderRadius: 8,
                    columnWidth: "42%"
                }
            },
            dataLabels: { enabled: false },
            grid: { borderColor: "#edf1f7" },
            yaxis: { labels: { style: { colors: "#8090a7" } } },
            xaxis: { labels: { style: { colors: "#8090a7" } } }
        });
        departmentChart.render();
    }

    function filterMeetingLogs() {
        const input = document.getElementById("meetingSearchInput");
        const filter = input.value.toUpperCase();
        const rows = document.querySelectorAll("#meetingLogsWrap .mom-log-row");

        rows.forEach(function (row) {
            const title = row.querySelector(".mom-log-title");
            const text = title ? title.textContent || title.innerText : "";
            row.style.display = text.toUpperCase().indexOf(filter) > -1 ? "" : "none";
        });
    }
</script>


