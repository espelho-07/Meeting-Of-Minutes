@model List<DepartmentModel>

@await Html.PartialAsync("_AlertMessages")
@await Html.PartialAsync("_SaaSListStyles")
@{
    ViewData["Title"] = "Departments - Meeting Of Minutes";
    int SerialNumber = 1;
}

<div class="pagetitle mb-4">
    <nav>
        <ol class="breadcrumb flex-nowrap">
            <li class="breadcrumb-item"><a asp-controller="DashBoard" asp-action="DashBoard"><i class="bi bi-house-door"></i></a></li>
            <li class="breadcrumb-item active">Departments</li>
        </ol>
    </nav>
</div>

<div class="list-page">
    <section class="list-hero">
        <div class="list-hero-main">
            <div class="list-kicker"><i class="bi bi-building"></i> Department Workspace</div>
            <h1 class="list-title">Departments</h1>
            <p class="list-subtitle">Organize business units, keep staff placement clear and maintain the department structure used across meetings, attendance and access.</p>
        </div>
        <aside class="list-note">
            <div class="list-note-label">Structure snapshot</div>
            <h2 class="list-note-title">@Model.Count departments are active in the current company scope.</h2>
            <ul class="list-note-list">
                <li><i class="bi bi-check2-circle"></i><span>Staff and meetings remain scoped to the department records shown here.</span></li>
                <li><i class="bi bi-check2-circle"></i><span>Counts help you review where teams and meetings are concentrated.</span></li>
                <li><i class="bi bi-check2-circle"></i><span>Department ownership drives user access across the application.</span></li>
            </ul>
        </aside>
    </section>

    <section class="list-surface">
        <div class="list-surface-header">
            <div>
                <h3 class="list-surface-heading">Department Directory</h3>
                <p class="list-surface-meta">Search, review and update department records from one shared management surface.</p>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <a asp-action="DepartmentAddEdit" class="btn list-btn list-btn-primary"><i class="bi bi-plus-circle me-2"></i>Add Department</a>
                <a asp-action="ExportToExcel" class="btn list-btn list-btn-success"><i class="bi bi-file-earmark-excel me-2"></i>Export</a>
            </div>
        </div>

        <div class="list-search-wrap">
            <form class="list-search-form" asp-action="DepartmentList" asp-controller="Department" method="post">
                @Html.AntiForgeryToken()
                <div class="list-search-input">
                    <span><i class="bi bi-search"></i></span>
                    <input class="form-control" name="searchtext" value="@ViewBag.searchtext" type="text" placeholder="Search departments..." />
                </div>
                <button class="btn list-btn list-btn-primary" type="submit">Search</button>
                <a href="@Url.Action("DepartmentList", "Department")" class="btn list-btn list-btn-light">Clear</a>
            </form>
            <div class="list-status-chip">Total Departments: @Model.Count</div>
        </div>

        <div class="list-table-wrap">
            <div class="list-table-card">
                @if (Model.Count == 0)
                {
                    <div class="list-empty">No departments found.</div>
                }
                else
                {
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th class="ps-4">#</th>
                                <th>Department Name</th>
                                <th>Staff Count</th>
                                <th>Meetings</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var dept in Model)
                            {
                                <tr>
                                    <td class="ps-4">@SerialNumber</td>
                                    <td>
                                        <div class="fw-bold text-dark">@dept.DepartmentName</div>
                                        <div class="small text-muted">Department workspace entry</div>
                                    </td>
                                    <td><span class="mom-count-pill staff"><i class="bi bi-people"></i> @dept.StaffCount</span></td>
                                    <td><span class="mom-count-pill meeting"><i class="bi bi-calendar-event"></i> @dept.MeetingsCount</span></td>
                                    <td class="text-center">
                                        <a asp-action="DepartmentView" asp-route-id="@dept.DepartmentID" class="mom-icon-btn text-primary me-1" title="View"><i class="bi bi-eye"></i></a>
                                        <a asp-action="DepartmentAddEdit" asp-route-id="@dept.DepartmentID" class="mom-icon-btn text-warning me-1" title="Edit"><i class="bi bi-pencil"></i></a>
                                        <form asp-action="Delete" method="post" class="d-inline js-delete-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="DepartmentID" value="@dept.DepartmentID" />
                                            <button type="submit" class="btn btn-link mom-icon-btn text-danger p-0" title="Delete"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </td>
                                </tr>
                                SerialNumber++;
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </section>
</div>
