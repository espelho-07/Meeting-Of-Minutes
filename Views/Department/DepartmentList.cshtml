@model PagedListViewModel<DepartmentModel>

@await Html.PartialAsync("_AlertMessages")
@await Html.PartialAsync("_SaaSListStyles")
@{
    ViewData["Title"] = "Departments - Meeting Of Minutes";
    int SerialNumber = 1;
    var heroModel = new ListPageHeroViewModel
    {
        IconClass = "bi bi-building",
        Kicker = "Department Workspace",
        Title = "Departments",
        Subtitle = "Organize business units, keep staff placement clear and maintain the department structure used across meetings, attendance and access.",
        NoteLabel = "Structure snapshot",
        NoteTitle = $"{Model.TotalItems} departments are active in the current company scope.",
        Notes = new List<string>
        {
            "Staff and meetings remain scoped to the department records shown here.",
            "Counts help you review where teams and meetings are concentrated.",
            "Department ownership drives user access across the application."
        }
    };
    var toolbarModel = new ListPageToolbarViewModel
    {
        Heading = "Department Directory",
        Meta = "Search, review and update department records from one shared management surface.",
        SearchAction = "DepartmentList",
        SearchController = "Department",
        SearchPlaceholder = "Search departments...",
        SearchText = ViewBag.searchtext,
        StatusText = $"Total Departments: {Model.TotalItems}",
        TemplateAction = "DownloadImportTemplate",
        TemplateController = "Department",
        ImportAction = "ImportFromExcel",
        ImportController = "Department",
        Actions = new List<ListToolbarActionViewModel>
        {
            new() { Action = "DepartmentAddEdit", Text = "Add Department", IconClass = "bi bi-plus-circle", CssClass = "list-btn-primary" },
            new() { Action = "ExportToExcel", Text = "Export", IconClass = "bi bi-file-earmark-excel", CssClass = "list-btn-success" }
        }
    };
}

@await Html.PartialAsync("_ListBreadcrumb", new ListBreadcrumbViewModel { CurrentLabel = "Departments" })

<div class="list-page">
    @await Html.PartialAsync("_ListPageHero", heroModel)

    <section class="list-surface">
        @await Html.PartialAsync("_ListPageToolbar", toolbarModel)

        <div class="list-table-wrap">
            <div class="list-table-card">
                @if (Model.Items.Count == 0)
                {
                    @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel
                    {
                        IconClass = "bi bi-building",
                        Title = "No departments found",
                        Description = "There are no department records matching the current search or filter state.",
                        ActionText = "Add Department",
                        ActionUrl = Url.Action("DepartmentAddEdit", "Department"),
                        Compact = true
                    })
                }
                else
                {
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th class="ps-4">#</th>
                                <th><a class="list-sort-link" href="@Url.Action("DepartmentList", new { searchtext = Model.SearchText, page = 1, sortBy = "name", sortDirection = Model.SortBy == "name" && Model.SortDirection == "asc" ? "desc" : "asc" })">Department Name <i class="bi bi-arrow-down-up"></i></a></th>
                                <th><a class="list-sort-link" href="@Url.Action("DepartmentList", new { searchtext = Model.SearchText, page = 1, sortBy = "staff", sortDirection = Model.SortBy == "staff" && Model.SortDirection == "asc" ? "desc" : "asc" })">Staff Count <i class="bi bi-arrow-down-up"></i></a></th>
                                <th><a class="list-sort-link" href="@Url.Action("DepartmentList", new { searchtext = Model.SearchText, page = 1, sortBy = "meetings", sortDirection = Model.SortBy == "meetings" && Model.SortDirection == "asc" ? "desc" : "asc" })">Meetings <i class="bi bi-arrow-down-up"></i></a></th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var dept in Model.Items)
                            {
                                <tr>
                                    <td class="ps-4">@SerialNumber</td>
                                    <td>
                                        <div class="fw-bold text-dark">@dept.DepartmentName</div>
                                        <div class="small text-muted">Department workspace entry</div>
                                    </td>
                                    <td><span class="mom-count-pill staff"><i class="bi bi-people"></i> @dept.StaffCount</span></td>
                                    <td><span class="mom-count-pill meeting"><i class="bi bi-calendar-event"></i> @dept.MeetingsCount</span></td>
                                    <td class="text-center">
                                        <a asp-action="DepartmentView" asp-route-id="@dept.DepartmentID" class="mom-icon-btn text-primary me-1" title="View"><i class="bi bi-eye"></i></a>
                                        <a asp-action="DepartmentAddEdit" asp-route-id="@dept.DepartmentID" class="mom-icon-btn text-warning me-1" title="Edit"><i class="bi bi-pencil"></i></a>
                                        <form asp-action="Delete" method="post" class="d-inline js-delete-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="DepartmentID" value="@dept.DepartmentID" />
                                            <button type="submit" class="btn btn-link mom-icon-btn text-danger p-0" title="Delete"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </td>
                                </tr>
                                SerialNumber++;
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
        @await Html.PartialAsync("_ListPagination", Model)
    </section>
</div>
