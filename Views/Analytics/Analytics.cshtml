@model Meeting_Of_Minutes.Models.AnalyticsViewModel
@using System.Text.Json

@await Html.PartialAsync("_AlertMessages")
@await Html.PartialAsync("_SaaSListStyles")
@{
    ViewData["Title"] = "Analytics - Meeting Of Minutes";
    string trendLabelsJson = JsonSerializer.Serialize(Model.TrendLabels);
    string trendMeetingValuesJson = JsonSerializer.Serialize(Model.TrendMeetingValues);
    string trendCancelledValuesJson = JsonSerializer.Serialize(Model.TrendCancelledValues);
    string departmentLabelsJson = JsonSerializer.Serialize(Model.TopDepartmentLabels);
    string departmentValuesJson = JsonSerializer.Serialize(Model.TopDepartmentValues);
    string typeLabelsJson = JsonSerializer.Serialize(Model.TopMeetingTypeLabels);
    string typeValuesJson = JsonSerializer.Serialize(Model.TopMeetingTypeValues);
}

<style>
    .analytics-page {
        width: min(100%, 1320px);
        display: grid;
        gap: 20px;
    }

    .analytics-filter-bar {
        display: flex;
        justify-content: space-between;
        gap: 14px;
        align-items: center;
        flex-wrap: wrap;
    }

    .analytics-filter-chips {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .analytics-chip {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 0 16px;
        border-radius: 999px;
        border: 1px solid #dfe5f3;
        background: #fff;
        color: #61708a;
        text-decoration: none;
        font-size: .88rem;
        font-weight: 800;
    }

    .analytics-chip.is-active {
        background: #f1f3ff;
        color: #5a5de0;
        border-color: #dfe3ff;
    }

    .analytics-stat-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
    }

    .analytics-stat-card,
    .analytics-panel {
        background: rgba(255,255,255,.96);
        border: 1px solid #e9edf7;
        border-radius: 24px;
        box-shadow: 0 18px 44px rgba(32, 41, 76, 0.07);
    }

    .analytics-stat-card {
        padding: 18px;
    }

    .analytics-stat-label {
        color: #8895ab;
        font-size: .76rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .08em;
        margin-bottom: 10px;
    }

    .analytics-stat-value {
        color: #18233f;
        font-size: 2rem;
        line-height: 1;
        font-weight: 900;
        letter-spacing: -.05em;
        margin-bottom: 8px;
    }

    .analytics-stat-meta {
        color: #66748f;
        font-size: .92rem;
    }

    .analytics-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.2fr) minmax(320px, .8fr);
        gap: 18px;
    }

    .analytics-panel {
        padding: 20px;
    }

    .analytics-panel-head {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        align-items: flex-start;
        margin-bottom: 16px;
        flex-wrap: wrap;
    }

    .analytics-panel-head h3 {
        margin: 0 0 6px;
        color: #1d2752;
        font-size: 1.08rem;
        font-weight: 800;
    }

    .analytics-panel-head p {
        margin: 0;
        color: #74839b;
        font-size: .9rem;
    }

    .analytics-chart {
        min-height: 320px;
    }

    .analytics-risk-list {
        display: grid;
        gap: 12px;
    }

    .analytics-risk-item {
        border: 1px solid #eef2f8;
        border-radius: 18px;
        padding: 14px;
        background: linear-gradient(180deg,#ffffff 0%,#fbfcff 100%);
    }

    .analytics-risk-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 6px;
    }

    .analytics-risk-title {
        color: #1d2752;
        font-weight: 800;
    }

    .analytics-risk-meta,
    .analytics-risk-text {
        color: #6b7891;
        font-size: .88rem;
    }

    .analytics-empty {
        padding: 26px 14px;
        text-align: center;
        color: #8390a7;
        font-weight: 600;
    }

    @@media (max-width: 1199px) {
        .analytics-stat-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .analytics-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 767px) {
        .analytics-stat-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

@await Html.PartialAsync("_ListBreadcrumb", new ListBreadcrumbViewModel { CurrentLabel = "Analytics" })

<div class="analytics-page">
    <section class="list-hero">
        <div class="list-hero-main">
            <div class="list-kicker"><i class="bi bi-graph-up-arrow"></i>@(Model.IsAdminUser ? "Company analytics" : "My analytics")</div>
            <h1 class="list-title">Analytics</h1>
            <p class="list-subtitle">Measure meeting flow, attendance volume, cancellations and distribution trends through a cleaner reporting workspace that follows your actual access scope.</p>
        </div>
        <aside class="list-note">
            <div class="list-note-label">Reporting scope</div>
            <h2 class="list-note-title">@Model.TotalMeetings visible meetings analyzed in the selected time range.</h2>
            <ul class="list-note-list">
                <li><i class="bi bi-check2-circle"></i><span>Admins see company-wide accessible records. Users see only assigned meeting scope.</span></li>
                <li><i class="bi bi-check2-circle"></i><span>Completion and cancellation percentages are calculated from visible meetings only.</span></li>
                <li><i class="bi bi-check2-circle"></i><span>Export the same view to Excel for reporting or review.</span></li>
            </ul>
        </aside>
    </section>

    <section class="list-surface">
        <div class="list-surface-header">
            <div>
                <h3 class="list-surface-heading">Insight Filters</h3>
                <p class="list-surface-meta">Switch reporting windows without leaving the analytics workspace.</p>
            </div>
            <a asp-action="ExportToExcel" asp-route-days="@Model.DaysFilter" class="btn list-btn list-btn-success">
                <i class="bi bi-file-earmark-excel me-2"></i>Export Report
            </a>
        </div>

        <div class="list-table-wrap">
            <div class="analytics-filter-bar">
                <div class="analytics-filter-chips">
                    <a class="analytics-chip @(Model.DaysFilter == 30 ? "is-active" : string.Empty)" asp-action="Analytics" asp-route-days="30">Last 30 Days</a>
                    <a class="analytics-chip @(Model.DaysFilter == 90 ? "is-active" : string.Empty)" asp-action="Analytics" asp-route-days="90">Last 90 Days</a>
                    <a class="analytics-chip @(Model.DaysFilter == 365 ? "is-active" : string.Empty)" asp-action="Analytics" asp-route-days="365">Last 12 Months</a>
                </div>
                <div class="list-status-chip">Completion Rate: @Model.CompletionRate.ToString("0.##")%</div>
            </div>

            <div class="analytics-stat-grid">
                <div class="analytics-stat-card">
                    <div class="analytics-stat-label">Meetings</div>
                    <div class="analytics-stat-value">@Model.TotalMeetings</div>
                    <div class="analytics-stat-meta">All visible meetings in the selected range.</div>
                </div>
                <div class="analytics-stat-card">
                    <div class="analytics-stat-label">Scheduled</div>
                    <div class="analytics-stat-value">@Model.ScheduledMeetings</div>
                    <div class="analytics-stat-meta">Upcoming or not-yet-completed meetings.</div>
                </div>
                <div class="analytics-stat-card">
                    <div class="analytics-stat-label">Completed</div>
                    <div class="analytics-stat-value">@Model.CompletedMeetings</div>
                    <div class="analytics-stat-meta">Finished meetings tracked in this workspace.</div>
                </div>
                <div class="analytics-stat-card">
                    <div class="analytics-stat-label">Attendance</div>
                    <div class="analytics-stat-value">@Model.AttendanceEntries</div>
                    <div class="analytics-stat-meta">Attendance entries across visible meetings.</div>
                </div>
            </div>
        </div>
    </section>

    <div class="analytics-grid">
        <section class="analytics-panel">
            <div class="analytics-panel-head">
                <div>
                    <h3>Meeting Trend</h3>
                    <p>Six-month trend of meeting creation and cancellations.</p>
                </div>
                <div class="list-status-chip">Cancellation Rate: @Model.CancellationRate.ToString("0.##")%</div>
            </div>
            <div id="analyticsTrendChart" class="analytics-chart"></div>
        </section>

        <section class="analytics-panel">
            <div class="analytics-panel-head">
                <div>
                    <h3>Risk Signals</h3>
                    <p>Recent critical platform events worth reviewing.</p>
                </div>
            </div>
            <div class="analytics-risk-list">
                @if (Model.RiskSignals.Count == 0)
                {
                    @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel
                    {
                        IconClass = "bi bi-shield-check",
                        Title = "No critical risk signals",
                        Description = "Nothing in the current analytics scope is triggering a critical review signal right now.",
                        Compact = true
                    })
                }
                else
                {
                    @foreach (var risk in Model.RiskSignals)
                    {
                        <div class="analytics-risk-item">
                            <div class="analytics-risk-top">
                                <div class="analytics-risk-title">@risk.Title</div>
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle">@risk.ActionType</span>
                            </div>
                            <div class="analytics-risk-text">@risk.Description</div>
                            <div class="analytics-risk-meta mt-2">@risk.Created.ToString("dd MMM yyyy • hh:mm tt")</div>
                        </div>
                    }
                }
            </div>
        </section>
    </div>

    <div class="analytics-grid">
        <section class="analytics-panel">
            <div class="analytics-panel-head">
                <div>
                    <h3>Department Distribution</h3>
                    <p>Which departments are driving the most meeting volume.</p>
                </div>
            </div>
            <div id="analyticsDepartmentChart" class="analytics-chart"></div>
        </section>

        <section class="analytics-panel">
            <div class="analytics-panel-head">
                <div>
                    <h3>Meeting Type Distribution</h3>
                    <p>Top categories currently shaping the visible workload.</p>
                </div>
            </div>
            <div id="analyticsTypeChart" class="analytics-chart"></div>
        </section>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const trendLabels = @Html.Raw(trendLabelsJson);
            const trendMeetingValues = @Html.Raw(trendMeetingValuesJson);
            const trendCancelledValues = @Html.Raw(trendCancelledValuesJson);
            const departmentLabels = @Html.Raw(departmentLabelsJson);
            const departmentValues = @Html.Raw(departmentValuesJson);
            const typeLabels = @Html.Raw(typeLabelsJson);
            const typeValues = @Html.Raw(typeValuesJson);

            new ApexCharts(document.querySelector("#analyticsTrendChart"), {
                series: [
                    { name: "Meetings", data: trendMeetingValues },
                    { name: "Cancelled", data: trendCancelledValues }
                ],
                chart: { height: 320, type: "area", toolbar: { show: false } },
                dataLabels: { enabled: false },
                stroke: { curve: "smooth", width: 3 },
                colors: ["#635bff", "#ef4444"],
                fill: {
                    type: "gradient",
                    gradient: { shadeIntensity: 1, opacityFrom: 0.28, opacityTo: 0.04, stops: [0, 100] }
                },
                xaxis: { categories: trendLabels },
                legend: { position: "top" }
            }).render();

            new ApexCharts(document.querySelector("#analyticsDepartmentChart"), {
                series: [{ name: "Meetings", data: departmentValues }],
                chart: { height: 320, type: "bar", toolbar: { show: false } },
                plotOptions: { bar: { borderRadius: 8, horizontal: true, barHeight: "44%" } },
                dataLabels: { enabled: false },
                colors: ["#5b5ce6"],
                xaxis: { categories: departmentLabels }
            }).render();

            new ApexCharts(document.querySelector("#analyticsTypeChart"), {
                series: typeValues,
                chart: { height: 320, type: "donut", toolbar: { show: false } },
                labels: typeLabels,
                colors: ["#635bff", "#7c3aed", "#0ea5e9", "#10b981", "#f59e0b", "#ef4444"],
                dataLabels: { enabled: false },
                legend: { position: "bottom" }
            }).render();
        });
    </script>
}
